  "jorden-rundt": {"navn": "Jorden Rundt", "synonymer": ["Jorden Rundt krydderiblanding"], "afdeling": "toer", "basisenhed": "g", "basisvare": true, "krydderiblanding": "hellofresh", "indhold": null, "indhold_kilde": null, "allergener": ["aeg", "sennep"], "blandingsforhold": null, "erstatning": "allround-krydderi", "note": "HelloFresh' egen krydderiblanding. HelloFresh kalder den 'vores færdige krydderiblanding, som vi kalder Jorden Rundt' (https://www.hellofresh.dk/recipes/graesk-hakkebof-63e6bbe9838062841f0e724d) og oplyser, at den indeholder æg og sennep (fx '4 g Jorden Rundt (Indeholder: Æg, Sennep)' på https://www.hellofresh.dk/recipes/ovnbagt-kyllingebryst-og-sprod-ostetopping-67c811ef8f112f54d1d75ba8), men ikke hvilke krydderier den består af. Den bruges til både græske hakkebøffer, shawarma, linsesalat og kylling, så den er vist en bred allround-blanding. Erstatningen er vores eget skøn."},
  "hvide-loejer-og-urter": {"navn": "Hvide Løjer & Urter", "synonymer": ["Hvide Løjer og Urter", "Hvide Løjer & Urter krydderiblanding"], "afdeling": "toer", "basisenhed": "g", "basisvare": true, "krydderiblanding": "hellofresh", "indhold": null, "indhold_kilde": null, "blandingsforhold": null, "erstatning": "hvidloeg-urtekrydderi", "note": "HelloFresh' egen krydderiblanding. HelloFresh kalder den 'vores aromatiske krydderiblanding, som vi kalder Hvide Løjer & Urter' (https://www.hellofresh.dk/recipes/jorden-rundt-krydret-svineschnitzel-675051cca54a6122a42d2d6d) og bruger den til retten 'Hvidløgsmarineret kylling' (https://www.hellofresh.dk/recipes/hvidlogsmarineret-kylling-61a77ce9f5a19e386e7741a8), men oplyser ikke indholdet, og der står ingen allergener ved den. Navnet og brugen tyder på hvidløg og urter, så et hvidløgs- og urtekrydderi fra butikken er den nærmeste erstatning."},
