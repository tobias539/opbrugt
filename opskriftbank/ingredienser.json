  "goan-xacuti": {"navn": "Goan Xacuti", "synonymer": ["Goan Xacuti krydderiblanding", "xacuti"], "afdeling": "toer", "basisenhed": "g", "basisvare": true, "krydderiblanding": "hellofresh", "indhold": null, "indhold_kilde": null, "allergener": [], "blandingsforhold": null, "erstatning": "karrypulver", "note": "HelloFresh' egen krydderiblanding. HelloFresh kalder den 'vores skønne krydderiblanding Goan Xacuti' (https://www.hellofresh.dk/recipes/krydret-chilikylling-655ca28653b95b70f998a5c2), men oplyser ikke indholdet, og ingredienslinjen ('4 g Goan Xacuti' på https://www.hellofresh.dk/recipes/hurtig-asiatisk-svine-og-kalvekodsbowl-6687abc7f5bcc18fabe96969) har ingen allergener. Xacuti er en karryblanding fra Goa, så karrypulver er valgt som erstatning; det er vores eget skøn."},
  "ga-laksa": {"navn": "Ga-Laksa", "synonymer": ["Ga-Laksa krydderiblanding", "galaksa"], "afdeling": "toer", "basisenhed": "g", "basisvare": true, "krydderiblanding": "hellofresh", "indhold": null, "indhold_kilde": null, "allergener": [], "blandingsforhold": null, "erstatning": "karrypulver", "note": "HelloFresh' egen krydderiblanding. HelloFresh kalder den 'vores færdiglavede krydderiblanding, som vi kalder Ga-Laksa' (https://www.hellofresh.dk/recipes/sydostasiatisk-kyllingelaksa-621652fe5989af0f4e16801e), men oplyser ikke indholdet. Ingredienslinjen '4 g Ga-Laksa' har ingen allergener (https://www.hellofresh.dk/recipes/sydostasiatisk-svinekod-64ae8d09b22c4a8c5919aa26), og kortet har heller ingen numre. Navnet peger på en laksa-blanding (malaysisk karry), så karrypulver er valgt som erstatning; det er vores eget skøn."},
  "ginger-ninja": {"navn": "Ginger Ninja", "synonymer": ["Ginger Ninja krydderiblanding", "Ginger-Ninja"], "afdeling": "toer", "basisenhed": "g", "basisvare": true, "krydderiblanding": "hellofresh", "indhold": null, "indhold_kilde": null, "allergener": ["aeg", "sennep"], "blandingsforhold": null, "erstatning": "ingefaer", "note": "HelloFresh' egen krydderiblanding. HelloFresh kalder den 'vores egen krydderiblanding med ingefær, som vi kalder Ginger Ninja' (https://www.hellofresh.dk/recipes/hurtig-sod-chilistegt-kylling-67358ef0bfb3b86dc50a6d90) og skriver '5 g Ginger Ninja (Indeholder: Æg, Sennep)', men oplyser ikke den fulde indholdsliste; derfor er indhold null. Kortene har også 8) 9). Ingefær (frisk eller stødt) er vores eget skøn som erstatning."},
  "curry-on": {"navn": "Curry-On", "synonymer": ["Curry-On krydderiblanding", "Curry-on"], "afdeling": "toer", "basisenhed": "g", "basisvare": true, "krydderiblanding": "hellofresh", "indhold": null, "indhold_kilde": null, "allergener": [], "blandingsforhold": null, "erstatning": "karrypulver", "note": "HelloFresh' egen krydderiblanding. HelloFresh oplyser ikke indholdet. I 'Malaysisk kyllingelaksa' (https://www.hellofresh.dk/recipes/malaysisk-kyllingelaksa-61c1f63e6375811e41544850), hvor der bruges 4 g Curry-On og 4 g Ga-Laksa, skriver HelloFresh, at saucen smages til 'med karrypulver og en lækker laksakrydderiblanding', så Curry-On er formentlig karrypulver; det er vores tolkning. Ingredienslinjen og kortet (2026-U09) har ingen allergennumre."},
  "kokosmel": {"navn": "Kokosmel", "synonymer": ["revet kokos", "kokosflager, fine", "tørret kokos"], "afdeling": "toer", "basisenhed": "g", "note": "HelloFresh-kortet (2026-U11) angiver kun spor af nødder, jordnødder, sesam og flere kornsorter."},
  "pasta": {"navn": "Pasta", "synonymer": ["rigatoni", "penne", "conchiglie", "konkylier", "pastaskaller", "fusilli", "tørret pasta", "orecchiette", "spaghetti", "linguine"], "afdeling": "toer", "basisenhed": "g", "allergener": ["gluten", "hvede"], "note": "Tørret pasta uden æg. HelloFresh skriver ofte bare 'Pasta' (rigatoni på billederne) eller formen, fx 'Conchiglie'. Kortene angiver spor af sennep og soja."},
  "souvlaki-krydderi": {"navn": "Souvlaki-krydderi", "synonymer": ["souvlaki krydderi", "souvlakikrydderi", "græsk krydderi"], "afdeling": "toer", "basisenhed": "g", "basisvare": true, "note": "Almindeligt krydderinavn, ikke et HelloFresh-fantasinavn. hellofresh.dk (https://www.hellofresh.dk/recipes/cremet-one-pot-med-chorizo-og-tortelloni-67dd381cf7a0f00255e99cd2) oplyser ikke indholdet. Kortet 2026-U15 angiver kun spor af selleri, krebsdyr, æg, fisk, mælk, sennep, sesam og soja."},
  "hello-sunrise": {"navn": "Hello Sunrise", "synonymer": ["Hello Sunrise krydderiblanding"], "afdeling": "toer", "basisenhed": "g", "basisvare": true, "krydderiblanding": "hellofresh", "indhold": null, "indhold_kilde": null, "allergener": ["selleri", "sennep"], "blandingsforhold": null, "erstatning": "allround-krydderi", "note": "HelloFresh' egen krydderiblanding. HelloFresh kalder den 'vores egen fantastiske krydderiblanding, som vi kalder Hello Sunrise' og skriver '4 g Hello Sunrise (Indeholder: Selleri, Sennep)' (https://www.hellofresh.dk/recipes/hello-sunrise-stegt-kylling-657ff6fbff39caf2068e4f85), men oplyser ikke, hvilke krydderier den består af. Den bruges til kylling, pulled pork-dressing, tomat-flødesauce til pasta og romescosalat, så allround-krydderi er valgt som erstatning; det er vores eget skøn."},
