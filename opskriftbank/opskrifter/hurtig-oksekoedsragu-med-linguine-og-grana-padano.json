  "trin": [
    {
      "nr": 1,
      "titel": "Kog pasta",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Kog pasta i 8 min, eller indtil 'al dente'.",
        "Gem en kop pastavand, og hæld resten fra.",
        "Imens, pres eller hak hvidløg fint.",
        "Opvarm olivenolie i en stor stegepande på middelhøj varme. Steg hakket oksekød, hvidløg og gulerod med Middelhavsdrøm, Hvide Løjer & Urter og salt i 4-5 min, eller indtil brunet."
      ],
      "tip": "Vandet skal være salt som havvand. - 'Al dente' betyder, at pastaen er kogt, men stadig har en smule bid.",
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 2,
      "titel": "Lav ragù",
      "tekst": [
        "Tilsæt worcestershiresauce, bouillon, hakkede tomater, madlavningsfløde, pastavand og et nip sukker, og bring i kog.",
        "Sænk til middel varme, og lad simre i 5-6 min, eller indtil tyknet."
      ],
      "tip": "Tilsæt et ekstra skvæt vand, hvis saucen er for tyk.",
      "vigtigt": "I denne opskrift bruges halvdelen af mængden af visse ingredienser – dobbelttjek ingredienslisten!"
    },
    {
      "nr": 3,
      "titel": "Vend sammen",
      "tekst": [
        "Imens, hak basilikum groft.",
        "Vend basilikum og pasta i ragù.",
        "Krydr med et nip salt og peber."
      ],
      "tip": "Vend eventuelt retten sammen i pastagryden, hvis det er nemmere."
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Anret oksekødsragù i dybe tallerkener.",
        "Top med Grana Padano.",
        "Dryp eventuelt med en smule olivenolie."
      ]
    }
  ],
