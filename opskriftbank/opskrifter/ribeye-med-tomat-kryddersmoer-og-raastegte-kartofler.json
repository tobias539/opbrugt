  "trin": [
    {
      "nr": 1,
      "titel": "Lav kryddersmør",
      "tekst": [
        "Hak de soltørrede tomater fint, knus hvidløget, og hak timianen.",
        "Rør tomat, paprika, hvidløg og timian sammen med det bløde smør, og smag til med salt og peber.",
        "Læg smørret på et stykke plastfolie, og rul det til en lille pølse. Læg det i køleskabet, til det skal bruges."
      ]
    },
    {
      "nr": 2,
      "titel": "Tag kødet ud",
      "tekst": [
        "Tag bøfferne ud af køleskabet en halv time, før de skal steges."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kartoflerne",
      "tekst": [
        "Skrub kartoflerne, dup dem tørre, og skær dem i tern.",
        "Varm olivenolien i en stor pande, og steg kartoflerne ved middel varme i ca. 20 min. Vend dem tit undervejs.",
        "Hak hvidløg og timian fint. Kom det på panden efter 15 min, og krydr med salt og peber.",
        "Steg kartoflerne færdige, til de er gyldne."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg bøfferne",
      "tekst": [
        "Krydr bøfferne med salt og peber.",
        "Steg dem ved høj varme i smør og olie i ca. 2-3 min på hver side, alt efter hvor store de er."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
      "tekst": [
        "Læg en skive kryddersmør på hver bøf, og server med kartoflerne."
      ],
      "tip": "Bagte halve tomater smager godt til."
    }
  ],
