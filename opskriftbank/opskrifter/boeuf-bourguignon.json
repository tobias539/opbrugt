  "trin": [
    {
      "nr": 1,
      "titel": "Forbered kød og grønt",
      "tekst": [
        "Skær kødet i tern på ca. 4 cm.",
        "Krydr med salt og peber, og vend kødet i melet.",
        "Skær løg, gulerødder og persillerødder i små tern.",
        "Skær hvidløget i tynde skiver."
      ]
    },
    {
      "nr": 2,
      "titel": "Brun kød og bacon",
      "tekst": [
        "Varm olien op i en gryde, og brun kødet i to omgange.",
        "Tag kødet op, og kom bacon i gryden.",
        "Steg et par minutter, og tilsæt løg, gulerødder og persillerødder.",
        "Steg i 5 min, til grøntsagerne får farve, og tilsæt hvidløg."
      ]
    },
    {
      "nr": 3,
      "titel": "Simr i rødvin",
      "tekst": [
        "Bind timian, persille og laurbærblade sammen til en lille urtebuket.",
        "Kom kødet tilbage i gryden sammen med buketten.",
        "Hæld rødvinen over, og skru ned for varmen.",
        "Lad retten simre i 1½ time, til kødet er mørt."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg svampe og perleløg",
      "tekst": [
        "Pil perleløgene, mens kødet simrer.",
        "Skær champignonerne i tykke skiver.",
        "Smelt smørret på en pande, og svits svampene ved høj varme i 5 min.",
        "Tilsæt perleløgene, steg dem med i 2 min, og sluk for varmen."
      ],
      "tip": "Blancher perleløgene i 1 min, så glider skallen let af. Du kan også bruge frosne perleløg."
    },
    {
      "nr": 5,
      "titel": "Smag til og server",
      "tekst": [
        "Smag saucen til med salt.",
        "Er der for meget væde, så lad retten koge lidt ind uden låg.",
        "Vend svampe og perleløg i gryden lige før servering.",
        "Drys med lidt persille, og server fx med kartoffelmos."
      ]
    }
  ],
