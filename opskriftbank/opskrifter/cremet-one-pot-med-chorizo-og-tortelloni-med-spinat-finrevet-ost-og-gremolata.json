  "trin": [
    {
      "nr": 1,
      "titel": "Steg chorizo",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middel varme.",
        "Steg chorizo i 4-5 min, eller indtil gennemstegt.",
        "Overfør til en tallerken med køkkenrulle."
      ]
    },
    {
      "nr": 2,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, hak løg fint.",
        "Skær gulerod i 1 cm tern.",
        "Skyl spinat."
      ]
    },
    {
      "nr": 3,
      "titel": "Lav sauce",
      "tekst": [
        "Opvarm samme stegepande på middelhøj varme.",
        "Steg løg og gulerod i 3-4 min, eller indtil bløde.",
        "Tilsæt souvlaki-krydderi, hakkede tomater, madlavningsfløde, vand, sukker, salt og et nip peber, og rør sammen."
      ]
    },
    {
      "nr": 4,
      "titel": "Tilsæt tortelloni",
      "tekst": [
        "Tilsæt tortelloni, og dæk med låg.",
        "Sænk til middel varme, og kog i 5-6 min, eller indtil pasta er 'al dente'."
      ],
      "tip": "'Al dente' betyder, at pastaen er kogt, men stadig har en smule bid."
    },
    {
      "nr": 5,
      "titel": "Lav gremolata",
      "tekst": [
        "Imens, hak persille fint.",
        "Pres eller hak hvidløg fint.",
        "Bland persille, hvidløg, chiliflager, olivenolie, salt og et nip peber i en lille skål.",
        "Tilsæt spinat og halvdelen af revet ost til stegepanden med pasta, og rør rundt indtil spinaten er faldet sammen."
      ],
      "tip": "Undlad chiliflager, eller brug mindre, hvis du ikke er til stærk mad."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret pasta i dybe tallerkener, og drys med resterende revet ost.",
        "Top voksentallerkenerne med gremolata og chorizo."
      ]
    }
  ],
