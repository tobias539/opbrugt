  "trin": [
    {
      "nr": 1,
      "titel": "Lav cajunris",
      "tekst": [
        "Smelt smør i en mellemstor gryde på middel varme.",
        "Svits Ay Cajun-ba i 30 sek, eller indtil velduftende.",
        "Tilsæt vand, og bring i kog. Tilsæt ris og salt, og kog under låg på middellav varme i 14 min. Tag gryden af varmen, og lad hvile under låg i 10 min."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Sylt løg",
      "tekst": [
        "Imens, hak løg fint.",
        "Skær citrusfrugt i både.",
        "Bland løg, et stort skvæt citrusfrugtsaft, salt og sukker i en lille skål, og stil til side."
      ]
    },
    {
      "nr": 3,
      "titel": "Bland fars",
      "tekst": [
        "Bland hakket oksekød, rasp, Tex-Mex, æg, salt og et nip peber i en mellemstor skål."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg hakkebøffer",
      "tekst": [
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Form fars til hakkebøffer (3 pr. person) direkte i panden med en ske, og steg i 5-6 min, eller indtil brunet og gennemstegte."
      ],
      "tip": "Farsen er blød, så vent med at vende, indtil der er dannet stegeskorpe. Bøfferne er færdige, når kødet er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Lav citrusdressing",
      "tekst": [
        "Imens, hak tomat og agurk fint.",
        "Bland agurk, tomat, olivenolie, salt og chiliflager i en skål.",
        "Vend mayonnaise og fraiche i skålen med løg lige inden servering."
      ],
      "tip": "Spring chiliflagerne over, eller brug mindre, hvis du ikke er til stærk mad."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret cajunris, hakkebøffer og tomatsalat på tallerkener.",
        "Server med citrusfrugtdressing."
      ]
    }
  ],
