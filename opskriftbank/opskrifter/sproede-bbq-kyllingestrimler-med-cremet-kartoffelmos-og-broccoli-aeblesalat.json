  "trin": [
    {
      "nr": 1,
      "titel": "Lav kartoffelmos",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Skræl kartoffel, og skær i 2 cm tern.",
        "Kog kartoffel og blomkålsbuketter i 11-13 min, eller indtil de nemt kan deles med en kniv. Hæld vand fra, og tilsæt mælk, salt og et nip peber. Mos med en kartoffelmoser eller gaffel, og stil til side med låg på."
      ],
      "tip": "Tilsæt en klat smør for en mere cremet mos."
    },
    {
      "nr": 2,
      "titel": "Paner kylling",
      "tekst": [
        "Imens, pisk æg i en dyb tallerken.",
        "Bland panko, salt og et nip peber i en anden dyb tallerken.",
        "Skær kylling i mindre stykker (3 pr. person) på et andet skærebræt, og krydr med salt.",
        "Vend kylling i æg og derefter i panko."
      ],
      "vigtigt": "En let lugt, når du åbner kyllingen, er helt normalt – det skyldes emballagen, som holder den frisk og god i smagen. Lad kyllingen få et par minutters luft, så er den klar til tilberedning!"
    },
    {
      "nr": 3,
      "titel": "Steg kylling",
      "tekst": [
        "Hæld olivenolie i en stor stegepande, så hele bunden er dækket, og varm op på middelhøj varme.",
        "Steg kylling i 3-4 min på hver side, eller indtil gylden og gennemstegt, og overfør til en tallerken med køkkenrulle."
      ],
      "tip": "Tilsæt ekstra olivenolie ved behov. Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Forbered frugt og grønt",
      "tekst": [
        "Imens, skær æble i 1 cm tern.",
        "Skær broccoli i små buketter og stokken i 1 cm tern."
      ]
    },
    {
      "nr": 5,
      "titel": "Lav broccoli-æblesalat",
      "tekst": [
        "Bland yoghurt, mayonnaise, vand, sukker, salt og et stort nip peber i en lille skål.",
        "Bland broccoli, æble, tranebær og halvdelen af yoghurtdressing i en stor skål."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret kylling, mos og broccoli-æblesalat på tallerkener.",
        "Server med resterende yoghurtdressing."
      ]
    }
  ],
