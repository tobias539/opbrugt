  "trin": [
    {
      "nr": 1,
      "titel": "Kog kartofler",
      "tekst": [
        "Bring en mellemstor gryde med saltet vand i kog.",
        "Skær kartofler (uskrællet) i 2 cm tern.",
        "Kog i 11-13 min, eller indtil de nemt kan deles med en kniv, og hæld vand fra.",
        "Stil til side med låg på."
      ]
    },
    {
      "nr": 2,
      "titel": "Steg kylling",
      "tekst": [
        "Krydr kylling med salt.",
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg kylling i 2 min på hver side, eller indtil brunet.",
        "Sænk til middel varme. Steg videre i 2-3 min på hver side, eller indtil gennemstegt, og overfør til en tallerken."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 3,
      "titel": "Lav majssalat",
      "tekst": [
        "Imens, skræl glaskål, og skær i 1 cm tern.",
        "Halver citrusfrugt.",
        "Hæld væde fra majs.",
        "Pisk olivenolie, citrusfrugtsaft, sukker og salt sammen i en stor skål.",
        "Vend kålblanding, majs og glaskål i skålen."
      ]
    },
    {
      "nr": 4,
      "titel": "Glaser kylling",
      "tekst": [
        "Smelt smør i samme stegepande på middel varme.",
        "Tilsæt BBQ-sauce og vand, og lad simre i 2-3 min, eller indtil gennemvarmet.",
        "Tilsæt kylling, og vend sammen."
      ]
    },
    {
      "nr": 5,
      "titel": "Tilsæt persille",
      "tekst": [
        "Hak persille fint.",
        "Vend persille og mayonnaise i gryden med kartofler lige inden servering.",
        "Smag til med salt og peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret majssalat, kartofler, kylling og BBQ-sauce på tallerkener."
      ]
    }
  ],
