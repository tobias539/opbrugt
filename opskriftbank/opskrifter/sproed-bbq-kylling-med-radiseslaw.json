  "trin": [
    {
      "nr": 1,
      "titel": "Bag grøntsager",
      "tekst": [
        "Forvarm ovnen til 240°C/220°C (varmluft).",
        "Skær gulerod, pastinak og rødbede (uskrællet) i 2 cm både.",
        "Skær blomkål i 2 cm buketter.",
        "Fordel grøntsager på en bageplade med bagepapir. Dryp med en smule olivenolie, krydr med Ay Cajun-ba, salt og et nip peber, og vend sammen.",
        "Bag i ovnen i 25-35 min, eller indtil møre."
      ],
      "tip": "Benyt flere bageplader, hvis der ikke er plads på en."
    },
    {
      "nr": 2,
      "titel": "Forbered slaw",
      "tekst": [
        "Imens, skær citrusfrugt i både.",
        "Bland rødkål, salt og et skvæt citrusfrugtsaft i en mellemstor skål."
      ]
    },
    {
      "nr": 3,
      "titel": "Paner kylling",
      "tekst": [
        "Skær kylling i 3 cm tern på et andet skærebræt.",
        "Pisk æg i en dyb tallerken.",
        "Bland panko, salt og et nip peber i en anden dyb tallerken.",
        "Vend kylling i æg og derefter i panko."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg kylling",
      "tekst": [
        "Hæld olivenolie i en stor stegepande, så hele bunden er dækket, og varm op på middelhøj varme.",
        "Steg kylling i 3-4 min på hver side, eller indtil gylden og gennemstegt, og overfør til en tallerken med køkkenrulle."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Lav radiseslaw",
      "tekst": [
        "Imens, skær radiser i tynde skiver.",
        "Vend radiser i skålen med rødkål.",
        "Pres eller hak hvidløg fint.",
        "Bland fraiche, hvidløg og et nip salt i en lille skål."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret grøntsager, radiseslaw og kylling på tallerkener.",
        "Server med hvidløgsyoghurt."
      ]
    }
  ],
