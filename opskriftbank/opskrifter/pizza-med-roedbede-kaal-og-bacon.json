  "trin": [
    {
      "nr": 1,
      "titel": "Lav dejen",
      "tekst": [
        "Opløs gæren i det lunkne vand, og tilsæt salt og 1 spsk olivenolie.",
        "Tilsæt melet, og ælt dejen godt, til den er smidig og elastisk.",
        "Lad dejen hæve et lunt sted i 1½ time."
      ]
    },
    {
      "nr": 2,
      "titel": "Varm ovn og plader op",
      "tekst": [
        "Tænd ovnen på det højeste, den kan, 250-300°C.",
        "Sæt bagepladerne ind, så de bliver varme."
      ]
    },
    {
      "nr": 3,
      "titel": "Forbered grøntsagerne",
      "tekst": [
        "Skræl rødbederne, og skær dem i meget tynde skiver.",
        "Skær rødløgene i strimler og rosenkålen i skiver."
      ]
    },
    {
      "nr": 4,
      "titel": "Top pizzaerne",
      "tekst": [
        "Del dejen i 2-4 stykker, og form dem til bunde.",
        "Læg hver bund på et stykke bagepapir.",
        "Smør tomatpuré på, og drys med mozzarella.",
        "Fordel rødbeder, rosenkål og rødløg, og læg baconskiverne ovenpå.",
        "Dryp med lidt olie, og krydr med salt og peber."
      ]
    },
    {
      "nr": 5,
      "titel": "Bag og server",
      "tekst": [
        "Tag de varme plader ud, og træk pizzaerne over på dem.",
        "Bag pizzaerne i 10-12 min.",
        "Drys med oregano."
      ]
    }
  ],
