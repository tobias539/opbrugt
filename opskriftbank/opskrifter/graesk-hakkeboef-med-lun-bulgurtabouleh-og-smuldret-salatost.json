  "trin": [
    {
      "nr": 1,
      "titel": "Kog bulgur",
      "tekst": [
        "Bring vand i kog i en mellemstor gryde.",
        "Tilsæt bulgur, bouillon og salt, og kog under låg på middellav varme i 9-10 min, eller indtil 'al dente'."
      ]
    },
    {
      "nr": 2,
      "titel": "Bland fars",
      "tekst": [
        "Hak løg fint.",
        "Bland hakket oksekød, halvdelen af løg, rasp, Middelhavsdrøm, æg og halvdelen af græsk ost med salt og et nip peber i en skål.",
        "Form fars til hakkebøffer (1 pr. person)."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg hakkebøffer",
      "tekst": [
        "Opvarm en smule olivenolie i en stegepande på middelhøj varme.",
        "Steg hakkebøffer i 4-5 min på hver side."
      ],
      "vigtigt": "Hakkebøfferne er færdige, når kødet er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Bland persilledressing",
      "tekst": [
        "Skær citrusfrugt i både.",
        "Hak persille fint.",
        "Bland yoghurt, et nip persille, salt, et skvæt citrusfrugtsaft og et nip peber i en lille skål."
      ]
    },
    {
      "nr": 5,
      "titel": "Bland taboulehsalat",
      "tekst": [
        "Hak agurk og tomat fint.",
        "Bland færdigkogt bulgur, agurk, tomat og resterende løg i en skål.",
        "Vend resterende persille, et skvæt citrusfrugtsaft og olivenolie i skålen, og krydr med et nip salt og peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret taboulehsalat og hakkebøffer på tallerkener.",
        "Top med resterende græsk ost.",
        "Dryp med persilledressing.",
        "Server med resterende citrusfrugtbåde."
      ]
    }
