  "trin": [
    {
      "nr": 1,
      "titel": "Bag tomaterne",
      "tekst": [
        "Tænd ovnen på 200°C varmluft.",
        "Læg tomaterne på en bageplade med snitfladen opad.",
        "Dryp med olivenolie, og drys med salt og peber.",
        "Bag dem i 25 min, og lad dem køle af på pladen, til de er lune."
      ]
    },
    {
      "nr": 2,
      "titel": "Rør estragondressing",
      "tekst": [
        "Rør estragon, løgpulver, sennep, citronskal, cremefraiche og mayonnaise sammen.",
        "Smag til med salt, peber og lidt citronsaft.",
        "Lad dressingen trække, mens du laver resten."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kødet",
      "tekst": [
        "Varm en pande op, og lad smørret bruse af.",
        "Krydr kødet med salt og peber, og steg det i 2-3 min på hver side.",
        "Lad kødet hvile i 5 min på et skærebræt, og skær det i skiver."
      ]
    },
    {
      "nr": 4,
      "titel": "Anret salaten",
      "tekst": [
        "Fordel krølsalat og rucola på tallerkener, og kom lidt dressing over.",
        "Top med de bagte tomater, agurk, rødløg og avocado.",
        "Læg kødet ovenpå, og drys med salt, peber og lidt estragon.",
        "Kom lidt ekstra dressing over, og server med det samme."
      ]
    }
  ],
