  "trin": [
    {
      "nr": 1,
      "titel": "Kog ris",
      "tekst": [
        "Forvarm ovnen til 200°C/180°C (varmluft).",
        "Bring vand i kog i en gryde.",
        "Tilsæt ris og salt, og kog under låg på middellav varme i 12 min. Tag gryden af varmen, og lad hvile under låg i 10 min."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Steg kylling",
      "tekst": [
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg kylling med salt i 2 min på hver side, eller indtil brunet.",
        "Overfør kylling til en bageplade med bagepapir, og bag i ovnen i 11-12 min, eller indtil gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt.",
      "vigtigt": "En let lugt, når du åbner kyllingen, er helt normalt – det skyldes emballagen, som holder den frisk og god i smagen. Lad kyllingen få et par minutters luft, så er den klar til tilberedning!"
    },
    {
      "nr": 3,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, skær gulerod (uskrællet) i 1/2 cm tern.",
        "Hak pak choi groft.",
        "Skær zucchini i tynde, halve skiver.",
        "Pres eller hak hvidløg fint.",
        "Skær citrusfrugt i både."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg grøntsager",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg gulerod og zucchini med Ginger Ninja i 3-4 min.",
        "Tilsæt pak choi og hvidløg, og steg videre i 1 min.",
        "Krydr med salt og et nip peber, og overfør til en skål.",
        "Bland sød chilisauce, sojasauce og et stort skvæt citrusfrugtsaft i en lille skål."
      ]
    },
    {
      "nr": 5,
      "titel": "Varm chilisauce",
      "tekst": [
        "Opvarm samme stegepande på middellav varme.",
        "Tilsæt chilisauce, og lad simre i 30 sek, eller indtil gennemvarmet.",
        "Skær kylling i skiver."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret ris og grøntsager i dybe tallerkener.",
        "Top med kylling og chilisauce.",
        "Server med citrusfrugtbåde."
      ]
    }
  ],
