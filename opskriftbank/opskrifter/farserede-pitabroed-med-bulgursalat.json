  "trin": [
    {
      "nr": 1,
      "titel": "Lav bulgursalaten",
      "tekst": [
        "Kog bulguren som anvist på pakken, og lad den køle lidt af.",
        "Rør citronskal, citronsaft, olivenolie, sukker og hvidløg sammen til en dressing, og smag godt til med salt og peber.",
        "Vend bulgur, tomat, agurk, rødløg, forårsløg, persille og mynte sammen med dressingen.",
        "Lad gerne salaten trække i en halv times tid før servering."
      ]
    },
    {
      "nr": 2,
      "titel": "Rør yoghurtdressingen",
      "tekst": [
        "Bland yoghurt, hvidløg, limeskal, limesaft og koriander.",
        "Smag til med salt og peber."
      ]
    },
    {
      "nr": 3,
      "titel": "Fyld pitabrødene",
      "tekst": [
        "Rør kødet sammen med løg, hvidløg, persille, spidskommen, begge slags paprika, koriander, salt og peber.",
        "Skær pitabrødene over på midten, og fordel farsen i de halve brød.",
        "Tryk dem flade, så kødet ligger i et tyndt og jævnt lag. Pensl brødene med olie."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg pitabrødene",
      "tekst": [
        "Varm en pande op ved middelvarme.",
        "Steg pitabrødene i 4-5 min på hver side."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
      "tekst": [
        "Server de varme pitabrød med bulgursalat og yoghurtdressing."
      ]
    }
  ],
