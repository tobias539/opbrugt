  "trin": [
    {
      "nr": 1,
      "titel": "Kog orzo",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Kog orzo i 8-9 min, eller indtil 'al dente', og hæld vand fra."
      ],
      "tip": "Vandet skal være salt som havvand. 'Al dente' betyder, at orzoen er kogt, men stadig har en smule bid."
    },
    {
      "nr": 2,
      "titel": "Steg kylling",
      "tekst": [
        "Skær kylling i mindre stykker (3 pr. person) på et andet skærebræt.",
        "Opvarm en smule olivenolie i en stegepande på middelhøj varme.",
        "Steg kylling med et nip salt i 3-4 min på hver side, eller indtil gylden og gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 3,
      "titel": "Lav salat",
      "tekst": [
        "Imens, hak agurk og tomat groft.",
        "Skyl spinat.",
        "Bland agurk, tomat, chiliflager, olivenolie, salt og et nip peber i en mellemstor skål.",
        "Bland yoghurt, pestodressing og et nip salt og peber i en lille skål.",
        "Vend Middelhavsdrøm, olivenolie, salt og et stort nip peber med færdig orzo.",
        "Lad køle af, og tilsæt blandet salat og spinat."
      ],
      "tip": "Undlad chilien, eller brug mindre, hvis alle ikke er til stærk mad."
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Anret orzo i dybe skåle.",
        "Top med salat og kylling.",
        "Server med pestodressing."
      ]
    }
  ],
