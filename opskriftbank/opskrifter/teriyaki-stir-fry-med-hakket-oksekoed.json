  "trin": [
    {
      "nr": 1,
      "titel": "Rør marinaden",
      "tekst": [
        "Kom teriyakisauce, soja, hvidløg, brun farin, ingefær, riseddike og vand i en skål.",
        "Sigt majsstivelsen i, og rør det godt sammen."
      ]
    },
    {
      "nr": 2,
      "titel": "Brun kød og svampe",
      "tekst": [
        "Varm sesamolien i en wok eller sauterpande.",
        "Brun oksekødet ved høj varme, og læg det til side på en tallerken.",
        "Rist champignonerne ved høj varme, til de har en gyldenbrun stegeskorpe."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg grøntsagerne",
      "tekst": [
        "Skru ned til middel varme, og kom kødet tilbage i wokken.",
        "Tilsæt løg, spidskål, peberfrugt, broccoli og sukkerærter.",
        "Varm grøntsagerne godt igennem i 3-4 min under konstant omrøring."
      ]
    },
    {
      "nr": 4,
      "titel": "Kog nudlerne",
      "tekst": [
        "Kog imens nudlerne som anvist på pakken.",
        "Hæld vandet fra, og fordel nudlerne i dybe skåle."
      ]
    },
    {
      "nr": 5,
      "titel": "Saml retten",
      "tekst": [
        "Hæld marinaden i wokken, og vend det hele ved høj varme i 1-2 min.",
        "Fordel straks over nudlerne, og drys med sesamfrø."
      ]
    }
  ],
