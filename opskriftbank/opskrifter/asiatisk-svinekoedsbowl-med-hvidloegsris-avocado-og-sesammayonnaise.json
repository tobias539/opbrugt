  "trin": [
    {
      "nr": 1,
      "titel": "Kog hvidløgsris",
      "tekst": [
        "Pres eller hak hvidløg fint.",
        "Opvarm olivenolie i en gryde på middel varme.",
        "Svits hvidløg i 30 sek, eller indtil velduftende.",
        "Tilsæt vand, og bring i kog. Tilsæt ris og salt, og kog under låg på lav varme i 12 min. Tag gryden af varmen, og lad hvile under låg i 10 min."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Forbered råvarer",
      "tekst": [
        "Imens, halver avocado, og fjern sten. Grav indmad ud med en ske, og skær i tynde skiver.",
        "Skær gulerod (uskrællet) i tynde, halve skiver.",
        "Hak pak choi groft."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg grøntsager",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg gulerod i 3-4 min, eller indtil møre.",
        "Tilsæt pak choi, og steg videre i 2 min.",
        "Krydr med salt og et nip peber, og overfør til en skål."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg kød",
      "tekst": [
        "Opvarm samme stegepande (tilsæt en smule olivenolie ved behov) på middelhøj varme.",
        "Steg hakket svinekød med Ga-Laksa og salt i 4-5 min, eller indtil brunet."
      ],
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Tilsæt grøntsager",
      "tekst": [
        "Tilsæt gulerod, pak choi, sojasauce og sukker til stegepanden, og steg i 1-2 min, eller indtil gennemvarmet.",
        "Krydr med salt og et nip peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret hvidløgsris, svinekød og grøntsager i dybe tallerkener.",
        "Dryp med sesammayonnaise.",
        "Top med avocado og asiatisk dressing."
      ]
    }
  ],
