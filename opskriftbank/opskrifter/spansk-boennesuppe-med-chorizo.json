  "trin": [
    {
      "nr": 1,
      "titel": "Forbered",
      "tekst": [
        "Skær chorizoen i tern, og hak løg, hvidløg og soltørrede tomater fint.",
        "Skær bladselleri i tynde skiver og gulerødder i små tern. Hak fennikelfrøene fint."
      ]
    },
    {
      "nr": 2,
      "titel": "Svits",
      "tekst": [
        "Varm olien i en stor gryde.",
        "Svits chorizo, løg, hvidløg og soltørrede tomater, til løgene er bløde."
      ]
    },
    {
      "nr": 3,
      "titel": "Simr suppen",
      "tekst": [
        "Tilsæt hakkede tomater, bladselleri, gulerødder, bouillon, røget paprika, safran, fennikelfrø og timian.",
        "Bring suppen i kog under omrøring. Læg låg på, og lad den simre i 15-20 min."
      ]
    },
    {
      "nr": 4,
      "titel": "Tilsæt bønnerne",
      "tekst": [
        "Hæld bønnerne i en sigte, skyl dem, og lad dem dryppe af.",
        "Kom dem i suppen, og varm dem godt igennem. Smag til med salt og peber."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
      "tekst": [
        "Hak persillen fint.",
        "Server suppen i dybe tallerkener eller skåle med et drys persille."
      ],
      "tip": "Lav gerne suppen til to dage. Den bliver kun bedre af at trække natten over i køleskabet."
    }
  ],
