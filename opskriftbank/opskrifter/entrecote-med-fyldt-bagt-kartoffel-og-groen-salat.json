  "trin": [
    {
      "nr": 1,
      "titel": "Bag kartoflerne",
      "tekst": [
        "Tænd ovnen på 175°C.",
        "Tag entrecoterne ud af køleskabet, så de har ligget ca. 30 min ved stuetemperatur, når de skal steges.",
        "Halver bagekartoflerne, og skær et rudemønster i snitfladerne.",
        "Læg dem i et ildfast fad, og bag dem i ca. 25 min."
      ]
    },
    {
      "nr": 2,
      "titel": "Fyld kartoflerne",
      "tekst": [
        "Tag kartoflerne ud, og skrab lidt af indmaden over i en skål med en ske.",
        "Rør indmaden sammen med gedeost, creme fraiche, citronskal, hakket timian, salt og peber.",
        "Fyld blandingen tilbage i kartoflerne, og læg evt. et par ekstra skiver gedeost ovenpå.",
        "Bag kartoflerne videre i 10-15 min, til de er gyldne."
      ]
    },
    {
      "nr": 3,
      "titel": "Grill bøfferne",
      "tekst": [
        "Krydr entrecoterne med salt og peber, og pensl dem let med olie.",
        "Varm en grillpande eller en grill godt op, og læg bøfferne på.",
        "Steg dem til en kernetemperatur på 56°C, så de bliver medium.",
        "Lad dem hvile på en rist i ca. 5 min."
      ]
    },
    {
      "nr": 4,
      "titel": "Lav salaten",
      "tekst": [
        "Skyl salaten. Blancher edamamebønnerne i kogende vand.",
        "Skær squashen i 0,5 cm tykke skiver og forårsløgene i mundrette stykker. Grill dem på grillen eller grillpanden.",
        "Pisk balsamico, olivenolie, honning og peber sammen til en dressing.",
        "Vend salat og grøntsager med dressingen, og smag til med timian og kryddersalt."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
      "tekst": [
        "Anret bøfferne med de fyldte kartofler og salaten.",
        "Pynt med timian."
      ],
      "tip": "Grillede asparges og kogte rødbeder passer også godt i salaten, især sammen med gedeost og honningdressing."
    }
  ],
  "allergener": {
    "indeholder": [
      "maelk",
      "soja",
      "svovldioxid"
    ],
    "spor_af": []
  },
  "noter": "Kilden angiver 20 min i alt, men kartoflerne skal bage 25 min og derefter 10-15 min til, så tiden er sat til 45 min."
