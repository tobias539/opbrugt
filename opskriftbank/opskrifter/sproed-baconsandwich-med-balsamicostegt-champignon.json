  "trin": [
    {
      "nr": 1,
      "titel": "Bag bacon",
      "tekst": [
        "Forvarm ovnen til 220°C/200°C (varmluft).",
        "Fordel bacon på en bageplade med bagepapir.",
        "Bag i ovnen i 13-15 min, eller indtil gylden og sprød."
      ]
    },
    {
      "nr": 2,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, skær svampe i tynde skiver.",
        "Skær løg i tynde, halve skiver.",
        "Skyl salat."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg svampe",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg løg i 1-2 min, eller indtil bløde.",
        "Tilsæt svampe, og steg videre i 3-5 min.",
        "Tilsæt balsamico og salt, og steg i yderligere 3-5 min, eller indtil karamelliseret."
      ]
    },
    {
      "nr": 4,
      "titel": "Bland persilleolie",
      "tekst": [
        "Imens, hak persille fint.",
        "Pres eller hak løg fint.",
        "Bland løg, persille, olivenolie og et nip salt i en lille skål."
      ]
    },
    {
      "nr": 5,
      "titel": "Varm brød",
      "tekst": [
        "Del brød på midten, og smør med persilleolie.",
        "Varm i ovnen i 6-8 min, eller indtil sprøde.",
        "Imens, skær æble i tynde skiver."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Smør underbolle med mayonnaise.",
        "Fyld med svampe, løg, bacon, salat og æble.",
        "Top med overbolle."
      ]
    }
  ],
