  "trin": [
    {
      "nr": 1,
      "titel": "Svits krydderierne",
      "tekst": [
        "Varm olien i en stor pande, og lad smørret bruse af i den. Skru ned på middel varme.",
        "Svits løg, hvidløg, ingefær, garam masala, nellike, kardemomme og chiliflager i nogle minutter, til løgene er bløde og det dufter godt."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog saucen",
      "tekst": [
        "Tilsæt gurkemeje, cashewnødder, hakkede tomater og bouillon, og bring det i kog under omrøring.",
        "Skru ned, læg låg på, og lad saucen simre ved lav varme i 15 min."
      ]
    },
    {
      "nr": 3,
      "titel": "Blend saucen",
      "tekst": [
        "Blend ¾ af saucen helt glat og cremet.",
        "Hæld den tilbage på panden til resten af saucen, og rør godt rundt.",
        "Rør piskefløden i, og smag til med salt og peber."
      ]
    },
    {
      "nr": 4,
      "titel": "Tilsæt paneer",
      "tekst": [
        "Skru ned på lav varme, og hak koriandren fint.",
        "Kom paneer og halvdelen af koriandren i saucen. Gem resten af koriandren til servering.",
        "Læg låg på, og kog imens risene efter anvisningen på pakken."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
      "tekst": [
        "Fordel ris og butter paneer i dybe tallerkener.",
        "Top med en skefuld fløde og en lille klat smør, og drys med koriander og ristede cashewnødder.",
        "Server med naan."
      ]
    }
  ],
