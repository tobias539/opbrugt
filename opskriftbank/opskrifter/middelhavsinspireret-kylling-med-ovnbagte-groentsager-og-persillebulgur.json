  "trin": [
    {
      "nr": 1,
      "titel": "Bag grøntsager",
      "tekst": [
        "Forvarm ovnen til 220°C/200°C (varmluft).",
        "Skær peberfrugt og tomat i 2 cm tern.",
        "Skær rødløg i 2 cm både.",
        "Fordel grøntsager på en bageplade med bagepapir. Dryp med en smule olivenolie, krydr med Middelhavsdrøm, bouillon, salt og et nip peber, og vend sammen.",
        "Bag i ovnen i 10-15 min, eller indtil møre."
      ],
      "tip": "Benyt flere bageplader, hvis der ikke er plads på en."
    },
    {
      "nr": 2,
      "titel": "Kog bulgur",
      "tekst": [
        "Bring vand i kog i en gryde.",
        "Tilsæt bulgur og salt, og kog under låg på middellav varme i 9-10 min, eller indtil 'al dente'."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kylling",
      "tekst": [
        "Skær kylling i mindre stykker (3 pr. person) på et andet skærebræt.",
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg kylling med salt i 3 min på hver side, eller indtil brunet og gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Forbered råvarer",
      "tekst": [
        "Imens, hak persille fint.",
        "Skær citron i både."
      ]
    },
    {
      "nr": 5,
      "titel": "Bland bulgur",
      "tekst": [
        "Bland yoghurt, et skvæt citronsaft og et nip salt og peber i en lille skål.",
        "Tilsæt bagte grøntsager, persille, olivenolie, et skvæt citronsaft og et nip salt og peber til gryden med færdigkogt bulgur, og vend sammen."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret bulgur og grøntsager i dybe tallerkener.",
        "Top med kylling.",
        "Drys med græskarkerner.",
        "Server med citronyoghurt."
      ]
    }
