  "trin": [
    {
      "nr": 1,
      "titel": "Kog kartofler",
      "tekst": [
        "Bring en mellemstor gryde med saltet vand i kog.",
        "Kog kartofler i 12-15 min, eller indtil de nemt kan deles med en kniv, og hæld vand fra.",
        "Krydr med et nip salt og peber, og stil til side med låg på."
      ]
    },
    {
      "nr": 2,
      "titel": "Steg kylling",
      "tekst": [
        "Krydr kylling med salt.",
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg kylling i 2-3 min på hver side, eller indtil brunet. Sænk til middel varme, og steg videre i 3-4 min på hver side, eller indtil gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 3,
      "titel": "Lav gremolata",
      "tekst": [
        "Hak persille fint.",
        "Pres eller hak hvidløg fint.",
        "Halver citrusfrugt.",
        "Bland persille, hvidløg, et nip chiliflager, citrusfrugtsaft, olivenolie, sukker og et nip salt og peber i en lille skål."
      ],
      "tip": "Spring chiliflagerne over, eller brug mindre, hvis du ikke er til stærk mad."
    },
    {
      "nr": 4,
      "titel": "Lav salat",
      "tekst": [
        "Skær radiser i kvarte.",
        "Skræl glaskål, og skær i 1/2 stave.",
        "Skyl blandet salat.",
        "Bland blandet salat, rødkål, radiser, glaskål, hvidvinseddike, olivenolie, salt og et nip peber i en stor skål."
      ]
    },
    {
      "nr": 5,
      "titel": "Tilsæt gremolata",
      "tekst": [
        "Vend gremolata i gryden med kogte kartofler.",
        "Skær kylling i skiver."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret kartofler, kylling og salat på tallerkener.",
        "Top med pestodressing."
      ]
    }
  ],
