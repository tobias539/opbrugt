  "trin": [
    {
      "nr": 1,
      "titel": "Kog marinaden",
      "tekst": [
        "Kom teriyakisauce, soja, hvidløg, brun farin, ingefær, riseddike og vand i en gryde.",
        "Sigt majsstivelsen i, og pisk, mens marinaden koger op.",
        "Sluk for varmen, og stil marinaden i køleskabet, til den har stuetemperatur."
      ]
    },
    {
      "nr": 2,
      "titel": "Mariner kyllingen",
      "tekst": [
        "Vend kyllingestrimlerne med et par spsk af den afkølede marinade, så de er dækket godt.",
        "Kom dem i en tæt beholder med låg, og stil dem på køl i mindst 30 min, gerne til dagen efter.",
        "Gem resten af marinaden til glasering."
      ]
    },
    {
      "nr": 3,
      "titel": "Sæt på spyd",
      "tekst": [
        "Træk strimlerne på grillspyd i tætte harmonikafolder.",
        "Pres kødet godt sammen på spyddene."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg spyddene",
      "tekst": [
        "Varm en pande eller grill godt op.",
        "Pensl spyddene med olie, og steg dem 3-4 min på hver side, til de er gennemstegte."
      ]
    },
    {
      "nr": 5,
      "titel": "Glaser og server",
      "tekst": [
        "Pensl de varme spyd med resten af marinaden.",
        "Drys med ristede sesamfrø og lidt finthakket koriander, og server."
      ]
    }
  ],
