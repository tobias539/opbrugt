  "trin": [
    {
      "nr": 1,
      "titel": "Mariner kødet",
      "tekst": [
        "Knus 1 fed hvidløg.",
        "Rør ketchup, hvidløg, sojasauce, olivenolie, 1 tsk paprika, brun farin og groft salt sammen til en marinade. Krydr med sort peber.",
        "Smør marinaden ud over hele flanksteaken."
      ]
    },
    {
      "nr": 2,
      "titel": "Grill flanksteaken",
      "tekst": [
        "Grill kødet ved høj varme i 2-3 min pr. side.",
        "Lad det hvile lidt, og skær det derefter i skiver på tværs."
      ]
    },
    {
      "nr": 3,
      "titel": "Rør chilismør",
      "tekst": [
        "Hak chilien fint, og knus det andet fed hvidløg.",
        "Rør det bløde smør med chili, 1 tsk paprika, timian, hvidløg og citronskal.",
        "Smag til med havsalt og peber."
      ]
    },
    {
      "nr": 4,
      "titel": "Grill chiliflutes",
      "tekst": [
        "Skær dybe snit på tværs af flutet.",
        "Fyld halvdelen af chilismørret ned i snittene.",
        "Grill brødet, til det er sprødt, og smørret er smeltet."
      ]
    },
    {
      "nr": 5,
      "titel": "Grill majs og server",
      "tekst": [
        "Pil bladene af majskolberne.",
        "Grill majsen, til den har fået farve og er mørkegul.",
        "Server kød, brød og majs med resten af chilismørret."
      ]
    }
  ],
