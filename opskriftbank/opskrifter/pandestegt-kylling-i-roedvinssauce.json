  "trin": [
    {
      "nr": 1,
      "titel": "Lav kartoffelmos",
      "tekst": [
        "Bring en gryde med saltet vand i kog.",
        "Skræl kartoffel, og skær i 2 cm tern.",
        "Kog i 11-13 min, eller indtil de nemt kan deles med en kniv.",
        "Hæld vand fra, og tilsæt mælk, salt og et nip peber. Mos med en kartoffelmoser eller gaffel, og stil til side med låg på."
      ],
      "tip": "Tilsæt en klat smør for en mere cremet mos."
    },
    {
      "nr": 2,
      "titel": "Bland dressing",
      "tekst": [
        "Imens, bland sennep, honning, olivenolie og et nip salt og peber i en stor skål."
      ]
    },
    {
      "nr": 3,
      "titel": "Tilsæt kål",
      "tekst": [
        "Tilsæt grønkål og rødkål til skålen med dressing, og masser med hænderne i 30 sek, eller indtil blød."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg kylling",
      "tekst": [
        "Skær kylling i mindre stykker (3 pr. person) på et andet skærebræt, og krydr med salt.",
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg kylling i 3 min på hver side, eller indtil brunet og gennemstegt, og overfør til en tallerken."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Tilsæt rødvinssauce",
      "tekst": [
        "Imens, pres eller hak hvidløg fint.",
        "Hak timian fint.",
        "Opvarm samme stegepande på middel varme.",
        "Tilsæt smør, hvidløg, timian, rødvinssauce, bouillon, vand og et nip peber, og lad simre i 2-3 min, eller indtil tyknet.",
        "Tilsæt kylling og kødsaft fra tallerkenen, og vend sammen."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret kartoffelmos og kylling på tallerkener.",
        "Top kylling med rødvinssauce.",
        "Server med kålsalat."
      ]
    }
  ],
