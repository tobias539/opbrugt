  "trin": [
    {
      "nr": 1,
      "titel": "Brun løg og kød",
      "tekst": [
        "Svits løget i lidt olie i en stor gryde, til det er blødt.",
        "Tilsæt oksekødet, og skru op for varmen.",
        "Brun kødet ved høj varme, mens du rører rundt."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog pastaen i gryden",
      "tekst": [
        "Tilsæt begge slags paprika, gulerødder, squash, hvidløg, hakkede tomater, bouillon og macaroni.",
        "Rør rundt i 1-2 min, til det simrer. Pastaen skal lige netop være dækket af grønt og væske.",
        "Læg låg på, og lad det simre ved svag til middel varme i 10 min."
      ]
    },
    {
      "nr": 3,
      "titel": "Tjek pastaen",
      "tekst": [
        "Rør rundt, og smag på pastaen.",
        "Er den ikke mør endnu, så lad den koge lidt længere."
      ]
    },
    {
      "nr": 4,
      "titel": "Smag til og server",
      "tekst": [
        "Smag til med sød sennep, ketchup, salt og peber.",
        "Rør halvdelen af cheddaren i lige før servering.",
        "Top med resten af osten og et drys persille."
      ]
    }
  ],
