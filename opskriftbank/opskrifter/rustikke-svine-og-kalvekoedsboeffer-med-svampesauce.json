  "trin": [
    {
      "nr": 1,
      "titel": "Kog kartofler",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Kog kartofler i 12-15 min, eller indtil de nemt kan deles med en kniv, og hæld vand fra.",
        "Krydr med salt og et nip peber, og stil til side med låg på."
      ]
    },
    {
      "nr": 2,
      "titel": "Steg bøffer",
      "tekst": [
        "Imens, riv løg groft.",
        "Bland hakket svine-/kalvekød, løg, æg, rasp, ketchup og salt i en stor skål.",
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Form fars til bøffer (3 pr. person) direkte i panden, tryk flade med en palet, og steg i 2-3 min, eller indtil gyldne og gennemstegte.",
        "Overfør til en tallerken, og dæk med sølvpapir."
      ],
      "vigtigt": "Bøfferne er færdige, når kødet er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 3,
      "titel": "Steg svampe",
      "tekst": [
        "Imens, hak svampe fint.",
        "Opvarm samme stegepande (tilsæt en smule olivenolie ved behov) på middelhøj varme.",
        "Steg svampe i 3-4 min, eller indtil gyldne, og krydr med salt."
      ]
    },
    {
      "nr": 4,
      "titel": "Lav æblesalat",
      "tekst": [
        "Imens, skær æble i tynde, halve skiver.",
        "Riv gulerod (uskrællet) groft.",
        "Hak persille groft.",
        "Bland æble, gulerod, persille og et nip salt i en mellemstor skål.",
        "Tilsæt eventuelt en smule olivenolie."
      ]
    },
    {
      "nr": 5,
      "titel": "Lav svampesauce",
      "tekst": [
        "Sænk varmen på stegepanden til lav.",
        "Tilsæt madlavningsfløde, sojasauce, salt og et stort nip peber, og lad simre i 1-2 min.",
        "Vend kartofler med smør i gryden lige inden servering."
      ],
      "vigtigt": "I denne opskrift bruges halvdelen af mængden af visse ingredienser – dobbelttjek ingredienslisten!"
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret bøffer, kartofler og æblesalat på tallerkener.",
        "Top bøffer med svampesauce."
      ]
    }
  ],
