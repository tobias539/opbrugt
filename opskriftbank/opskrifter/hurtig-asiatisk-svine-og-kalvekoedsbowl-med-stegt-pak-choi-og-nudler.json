  "trin": [
    {
      "nr": 1,
      "titel": "Steg hakket kød",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg hakket svine-/kalvekød i 4-5 min, eller indtil brunet.",
        "Imens, hak pak choi groft.",
        "Skær løg i tynde skiver."
      ],
      "tip": "Kogevandet skal være salt som havvand."
    },
    {
      "nr": 2,
      "titel": "Kog nudler",
      "tekst": [
        "Kog nudler i 4-6 min, eller indtil bløde.",
        "Gem en kop nudelvand, og hæld resten fra.",
        "Skyl nudler under koldt vand i en si."
      ]
    },
    {
      "nr": 3,
      "titel": "Lav sauce",
      "tekst": [
        "Tilsæt Goan Xacuti, chiliflager, løg, pak choi, spidskål og gulerod til stegepanden, og steg i 1-2 min, eller indtil kødet er gennemstegt.",
        "Tilsæt sød chilisauce, sojasauce, sataysauce og nudelvand, og tag af varmen.",
        "Tilsæt nudler, og vend sammen."
      ],
      "tip": "Spring chiliflagerne over, eller brug mindre, hvis du ikke er til stærk mad.",
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Anret nudler i dybe tallerkener.",
        "Top med peanuts."
      ]
    }
  ],
