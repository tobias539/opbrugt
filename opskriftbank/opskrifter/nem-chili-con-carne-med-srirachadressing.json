  "trin": [
    {
      "nr": 1,
      "titel": "Forbered chili",
      "tekst": [
        "Flæk chili, fjern kerner, og hak fint.",
        "Skyl sorte bønner under koldt vand i en si."
      ]
    },
    {
      "nr": 2,
      "titel": "Steg oksekød",
      "tekst": [
        "Opvarm olivenolie i en stor gryde på middelhøj varme.",
        "Steg hakket oksekød med Tex-Mex, salt og et nip peber i 4-5 min, eller indtil brunet."
      ],
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 3,
      "titel": "Lav chili",
      "tekst": [
        "Tilsæt hakkede tomater, chili, sorte bønner, oksebouillon og vand, og lad simre uden låg i 8-10 min, eller indtil tyknet.",
        "Smag til med salt og peber.",
        "Imens, bland fraiche og sriracha i en lille skål, og krydr med salt."
      ],
      "tip": "Spring chili og srirachaen over, eller brug mindre, hvis du ikke er til stærk mad."
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Anret chili i skåle.",
        "Top med srirachadressing.",
        "Server med tortillachips."
      ]
    }
  ],
