  "trin": [
    {
      "nr": 1,
      "titel": "Friter squashen",
      "tekst": [
        "Varm fritureolien op til 180 grader i en gryde.",
        "Friter squashskiverne lidt ad gangen.",
        "Tag dem op med en hulske, og lad dem dryppe af på køkkenrulle. Fortsæt, til alle skiver er friteret."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog pastaen halvt",
      "tekst": [
        "Kog spaghettien i letsaltet vand, til den er halvt færdig.",
        "Gem kogevandet i en skål til saucen, og hæld pastaen i en sigte."
      ]
    },
    {
      "nr": 3,
      "titel": "Kog færdig i panden",
      "tekst": [
        "Varm lidt olie i en stor sauterpande ved middelhøj varme.",
        "Kom den friterede squash, den halvkogte spaghetti og knust hvidløg på panden.",
        "Hæld 1-2 dl af pastavandet ved, og lad det simre.",
        "Lad pastaen koge færdig i panden, og hæld mere pastavand ved lidt ad gangen efter behov."
      ]
    },
    {
      "nr": 4,
      "titel": "Rør osten i",
      "tekst": [
        "Rør det meste af parmesanen i, når pastaen næsten er al dente.",
        "Juster med pastavand, til retten er cremet.",
        "Smag til med salt og peber."
      ]
    },
    {
      "nr": 5,
      "titel": "Anret",
      "tekst": [
        "Fordel pastaen på tallerkener.",
        "Drys med basilikumblade, resten af parmesanen og lidt ekstra peber."
      ]
    }
  ],
