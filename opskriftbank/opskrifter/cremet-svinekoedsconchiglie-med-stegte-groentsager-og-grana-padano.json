  "trin": [
    {
      "nr": 1,
      "titel": "Kog pasta",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Kog pasta i 11-12 min, eller indtil 'al dente'.",
        "Gem en kop pastavand, og hæld resten fra."
      ],
      "tip": "Kogevandet skal være salt som havvand. - 'Al dente' betyder, at pastaen er kogt, men stadig har en smule bid."
    },
    {
      "nr": 2,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, skær zucchini i 1/2 cm halve skiver.",
        "Halver cherrytomater.",
        "Pres eller hak hvidløg fint."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kød",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg hakket svinekød med salt og et nip peber i 3-4 min, eller indtil brunet."
      ],
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Steg grøntsager",
      "tekst": [
        "Tilsæt zucchini og cherrytomater, og steg i 2-3 min, eller indtil møre.",
        "Tilsæt hvidløg, Mamas Favorit og Middelhavsdrøm, og steg videre i 30 sek, eller indtil velduftende."
      ]
    },
    {
      "nr": 5,
      "titel": "Lav sauce",
      "tekst": [
        "Tilsæt madlavningsfløde, pastavand, bouillon, salt og et nip peber, og lad simre i 1-2 min, eller indtil let tyknet.",
        "Tilsæt pasta, og vend sammen."
      ],
      "tip": "Tilsæt et skvæt vand, hvis pastaen er for tør."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret pasta i dybe tallerkener.",
        "Drys med finrevet ost."
      ]
    }
  ],
