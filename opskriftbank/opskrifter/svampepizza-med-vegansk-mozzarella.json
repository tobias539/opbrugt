  "trin": [
    {
      "nr": 1,
      "titel": "Lav dejen",
      "tekst": [
        "Rør gæren ud i vandet.",
        "Kom hvedemel og 1 tsk groft salt i, og ælt dejen grundigt.",
        "Dæk den til, og lad den hæve i 1½ time, til den er dobbelt så stor."
      ],
      "vigtigt": "Kildens tid på 30 min er uden de 1½ time, dejen skal hæve."
    },
    {
      "nr": 2,
      "titel": "Steg svampene",
      "tekst": [
        "Skær svampene i skiver og rødløget i strimler.",
        "Varm 1 spsk olivenolie på en pande, og svits svampe og løg.",
        "Krydr med salt og peber, når svampene begynder at tage farve. Sluk derefter for varmen."
      ]
    },
    {
      "nr": 3,
      "titel": "Form bundene",
      "tekst": [
        "Tænd ovnen på 250°C.",
        "Del dejen i 2 kugler, og form hver kugle til en pizzabund.",
        "Læg bundene på bageplader, og pensl dem med resten af olivenolien."
      ]
    },
    {
      "nr": 4,
      "titel": "Top og bag",
      "tekst": [
        "Fordel den veganske ost på bundene, og læg svampene ovenpå.",
        "Drys med persille og timian.",
        "Bag pizzaerne ved 250°C i 12-15 min."
      ]
    }
  ],
