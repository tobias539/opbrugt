  "trin": [
    {
      "nr": 1,
      "titel": "Kog ris",
      "tekst": [
        "Snit forårsløg fint.",
        "Opvarm olivenolie i en gryde på middelhøj varme.",
        "Svits halvdelen af forårsløg i 1-2 min.",
        "Tilsæt vand, og bring i kog. Tilsæt ris og salt, og kog under låg på lav varme i 12 min. Tag gryden af varmen, og lad hvile under låg i 10 min, eller indtil vandet er absorberet."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Skær mango over på langs ca. 1 cm fra midten uden om stenen, og skær i 1 cm tern.",
        "Skær radiser i tynde skiver.",
        "Skær citrusfrugt i både.",
        "Flæk chili, fjern kerner, og hak fint."
      ]
    },
    {
      "nr": 3,
      "titel": "Lav mangosalsa",
      "tekst": [
        "Bland mango, radiser, rødkål, et stort skvæt citrusfrugtsaft, chili og resterende forårsløg i en skål, og krydr med salt og et nip peber."
      ],
      "tip": "Undlad chilien, hvis ikke alle er til stærk mad."
    },
    {
      "nr": 4,
      "titel": "Steg kylling",
      "tekst": [
        "Skær kylling i 3 cm tykke strimler på et andet skærebræt.",
        "Vend kylling med asiatisk woksauce og salt i en skål.",
        "Opvarm en smule olivenolie i en stegepande på middelhøj varme.",
        "Steg kylling i 4-5 min, eller indtil brunet og gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Bland sojamayonnaise",
      "tekst": [
        "Imens, bland mayonnaise og sojasauce i en lille skål."
      ],
      "vigtigt": "I denne opskrift bruges halvdelen af mængden af visse ingredienser – dobbelttjek ingredienslisten!"
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret forårsløgsris og kylling i dybe tallerkener.",
        "Top med mangosalsa.",
        "Server med sojamayonnaise og citrusfrugtbåde."
      ]
    }
  ],
