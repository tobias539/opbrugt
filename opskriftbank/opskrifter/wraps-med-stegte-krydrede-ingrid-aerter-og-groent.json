  "trin": [
    {
      "nr": 1,
      "titel": "Udblød ærterne",
      "tekst": [
        "Skyl de tørrede ærter, og læg dem i blød i rigeligt vand i køleskabet i mindst 12 timer."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog ærterne",
      "tekst": [
        "Hæld udblødningsvandet fra.",
        "Kog ærterne i rigeligt vand med lidt salt i 25-30 min.",
        "Hæld vandet fra."
      ]
    },
    {
      "nr": 3,
      "titel": "Lav dressing",
      "tekst": [
        "Skyl krydderurterne, og hak dem.",
        "Rør dem sammen med creme fraiche, citronsaft og fintrevet citronskal. Smag til med salt og peber.",
        "Stil dressingen på køl."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg ærterne",
      "tekst": [
        "Skyl forårsløg, tomater og chili, og skær dem i mundrette stykker.",
        "Steg de kogte ærter i lidt olie med krydderierne og forårsløgene ved middel varme i 8-10 min."
      ]
    },
    {
      "nr": 5,
      "titel": "Saml wraps",
      "tekst": [
        "Skyl salaten, og lun tortillaerne.",
        "Smør dressing på de lune wraps, og fyld dem med ærter og forårsløg, tomater, salat og chili.",
        "Top med syltede rødløg."
      ]
    }
  ],
  "noter": "Ærterne skal i blød i mindst 12 timer, så start dagen før. Tiden er uden udblødning (kilden skriver 750 min i alt).",
