  "trin": [
    {
      "nr": 1,
      "titel": "Lav pastinakmos",
      "tekst": [
        "Forvarm ovnen til 220°C/200°C (varmluft), og bring en stor gryde med saltet vand i kog.",
        "Skræl kartoffel (uskrællet) og pastinak (uskrællet), og skær i 2 cm tern. Skræl hvidløg.",
        "Kog kartofler, pastinak og halvdelen af hvidløg i 11-13 min, eller indtil de nemt kan deles med en kniv. Hæld vand fra, og tilsæt mælk, salt og et nip peber. Mos med en kartoffelmoser eller en gaffel, og stil til side med låg på."
      ],
      "tip": "Tilsæt en klat smør for en mere cremet mos."
    },
    {
      "nr": 2,
      "titel": "Mariner fennikel og æble",
      "tekst": [
        "Skær citrusfrugt i både.",
        "Skær fennikel i tynde, halve skiver.",
        "Skær æble i tynde, halve skiver.",
        "Bland olivenolie, et skvæt citrusfrugtsaft, sukker og et nip salt og peber i en mellemstor skål.",
        "Vend fennikel og æble i skålen, og lad marinere indtil servering."
      ]
    },
    {
      "nr": 3,
      "titel": "Bag fisk",
      "tekst": [
        "Dub fisk tør med køkkenrulle.",
        "Placer fisk på en bageplade med bagepapir. Dryp med olivenolie og et skvæt citrusfrugtsaft, og krydr med et nip salt og peber.",
        "Bag i ovnen i 12-15 min, eller indtil gylden og gennemstegt."
      ],
      "tip": "Fisken er færdig, når kødet er mælkehvidt og mat."
    },
    {
      "nr": 4,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, pres eller hak resterende hvidløg fint.",
        "Hak dild groft."
      ]
    },
    {
      "nr": 5,
      "titel": "Lav dildsauce",
      "tekst": [
        "Opvarm olivenolie i en anden mellemstor gryde på middelhøj varme.",
        "Svits hvidløg i 30 sek, eller indtil velduftende.",
        "Tilsæt bouillon, madlavningsfløde, salt og peber, og lad simre i 2-3 min, eller indtil tyknet.",
        "Tilsæt halvdelen af dild, og rør rundt."
      ],
      "tip": "Tilsæt et skvæt vand, hvis saucen virker tyk."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret pastinakmos og fisk på tallerkener.",
        "Top med dildsauce.",
        "Server med fennikel og æble.",
        "Drys med resterende dild."
      ]
    }
  ],
