  "trin": [
    {
      "nr": 1,
      "titel": "Svits løg og nduja",
      "tekst": [
        "Hak løg, hvidløg og soltørrede tomater fint.",
        "Svits løgene i olien på en pande, til de er bløde.",
        "Tilsæt soltørrede tomater, hvidløg og nduja, og rør godt, til nduja'en begynder at smelte ud på panden."
      ]
    },
    {
      "nr": 2,
      "titel": "Lav saucen",
      "tekst": [
        "Tilsæt hakkede tomater, sukker og piskefløde, og varm op, til saucen simrer svagt.",
        "Smag til med salt og peber, og lad saucen simre ved middellav varme."
      ]
    },
    {
      "nr": 3,
      "titel": "Kog pastaen",
      "tekst": [
        "Kog imens pastaen i let saltet vand, men stop 1-2 min før den er al dente.",
        "Tag lidt pastavand fra i en skål.",
        "Kom den varme pasta på panden med saucen, og vend godt. Justér konsistensen med pastavand efter behov."
      ]
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Vend spinat og basilikum i pastaen.",
        "Server på tallerkener med en halv burrata, revet parmesan, rucola og basilikumblade."
      ]
    }
  ],
