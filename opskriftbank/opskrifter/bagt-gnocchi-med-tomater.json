      "nr": 1,
      "titel": "Fyld fadet",
      "tekst": [
        "Forvarm ovnen til 175 grader varmluft.",
        "Smør et ovnfast fad med lidt olie.",
        "Kom gnocchi, rødløg og blommetomater i fadet."
      ]
    },
    {
      "nr": 2,
      "titel": "Krydderolie",
      "tekst": [
        "Rør soltørrede tomater, hvidløg, rosmarin og timian sammen med olivenolie, salt og peber i en skål.",
        "Hæld krydderolien over fadet, og vend det hele grundigt.",
        "Drys pinjekerner og den smuldrede ost over."
      ]
    },
    {
      "nr": 3,
      "titel": "Bag",
      "tekst": [
        "Bag fadet i ovnen i ca. 30 min."
      ]
