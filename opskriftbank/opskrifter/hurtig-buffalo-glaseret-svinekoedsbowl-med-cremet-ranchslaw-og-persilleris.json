  "trin": [
    {
      "nr": 1,
      "titel": "Kog ris",
      "tekst": [
        "Bring vand i kog i en mellemstor gryde.",
        "Tilsæt ris og salt, og kog under låg på middellav varme i 10 min.",
        "Tag gryden af varmen, og lad hvile indtil servering."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Steg kød",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg hakket svinekød med salt i 4-5 min, eller indtil brunet.",
        "Sænk til middel varme.",
        "Tilsæt smør og røget paprika, og steg i 30 sek, eller indtil velduftende.",
        "Tilsæt sriracha, honning og ketchup, rør rundt, og tag panden af varmen."
      ],
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 3,
      "titel": "Lav slaw",
      "tekst": [
        "Imens, hæld væde fra majs.",
        "Pres eller hak hvidløg fint.",
        "Bland fraiche, mayonnaise, hvidløg, majs, spidskål, gulerod, salt og et nip peber i en stor skål.",
        "Riv persille groft, og vend i gryden med ris lige inden servering."
      ]
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Anret ris, kød og slaw i dybe tallerkener."
      ]
    }
  ],
