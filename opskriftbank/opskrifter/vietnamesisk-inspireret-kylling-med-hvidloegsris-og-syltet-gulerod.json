  "trin": [
    {
      "nr": 1,
      "titel": "Kog hvidløgsris",
      "tekst": [
        "Pres eller hak hvidløg fint.",
        "Smelt smør i en mellemstor gryde på middel varme.",
        "Svits halvdelen af hvidløg i 30 sek, eller indtil velduftende.",
        "Tilsæt vand, og bring i kog. Tilsæt ris og salt, og kog under låg på middellav varme i 14 min. Tag gryden af varmen, og lad hvile under låg i 10 min."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Forbered råvarer",
      "tekst": [
        "Imens, skræl gulerod til lange, tynde bånd, og hak det sidste stykke fint.",
        "Hak pak choi og skalotteløg groft.",
        "Skær citrusfrugt i både."
      ]
    },
    {
      "nr": 3,
      "titel": "Sylt gulerod",
      "tekst": [
        "Bland hvidvinseddike, sukker, vand og et nip salt i en lille skål.",
        "Vend gulerod i skålen.",
        "Hæld lage fra inden servering.",
        "Vend kylling med hvedemel, salt og et nip peber i en stor skål.",
        "Bland sojasauce, sukker, et stort skvæt citrusfrugtsaft og resterende hvidløg i en lille skål."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg kylling",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg pak choi i 2-3 min, eller indtil blød. Krydr med et nip salt og peber, og overfør til en skål med låg.",
        "Opvarm samme stegepande (tilsæt en smule ved behov) på middelhøj varme.",
        "Steg kylling og skalotteløg i 4-5 min, eller indtil gennemstegt.",
        "Tag panden af varmen, tilsæt marinade, og vend sammen."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Forbered råvarer",
      "tekst": [
        "Imens, hak peanuts groft.",
        "Hak mynte og koriander groft.",
        "Flæk chili, fjern kerner, og skær i tynde skiver."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret hvidløgsris, kylling, pak choi og gulerod i dybe tallerkener.",
        "Top med peanuts, mynte, koriander og chili.",
        "Server med srirachamayonnaise og resterende citrusfrugtbåde."
      ],
      "tip": "Spring chilien over, eller brug mindre, hvis du ikke er til stærk mad."
    }
  ],
