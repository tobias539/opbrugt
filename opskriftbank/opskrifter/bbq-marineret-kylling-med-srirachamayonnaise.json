  "trin": [
    {
      "nr": 1,
      "titel": "Sylt rødløg",
      "tekst": [
        "Skær løg i tynde, halve skiver.",
        "Bland hvidvinseddike, sukker, vand og et nip salt i en lille skål.",
        "Vend løg i skålen, og stil til side."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog bulgur",
      "tekst": [
        "Bring vand i kog i en mellemstor gryde.",
        "Tilsæt bulgur og salt, og kog under låg på middellav varme i 9-10 min, eller indtil 'al dente'."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kylling",
      "tekst": [
        "Skær kylling i mindre stykker (3 pr. person) på et andet skærebræt.",
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg kylling med salt i 3-4 min på hver side, eller indtil brunet og gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Forbered frugt og grønt",
      "tekst": [
        "Skær mango over på langs ca. 1 cm fra midten uden om stenen, og skær i 1 cm tern.",
        "Skær peberfrugt og agurk i 1 cm tern."
      ]
    },
    {
      "nr": 5,
      "titel": "Hæld væde fra rødløg",
      "tekst": [
        "Hæld væde fra løg lige inden servering."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret bulgur i dybe tallerkener.",
        "Top med kylling, peberfrugt, agurk, mango og løg.",
        "Server med srirachamayonnaise."
      ]
    }
