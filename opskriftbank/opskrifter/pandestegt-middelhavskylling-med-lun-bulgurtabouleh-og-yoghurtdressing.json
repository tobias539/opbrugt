  "trin": [
    {
      "nr": 1,
      "titel": "Kog bulgur",
      "tekst": [
        "Pres eller hak hvidløg fint.",
        "Opvarm olivenolie i en mellemstor gryde på middel varme.",
        "Svits hvidløg i 1-2 min, eller indtil velduftende.",
        "Tilsæt vand, og bring i kog. Tilsæt bulgur, bouillon og salt, og kog under låg på middellav varme i 9-10 min, eller indtil 'al dente'."
      ]
    },
    {
      "nr": 2,
      "titel": "Steg kylling",
      "tekst": [
        "Krydr kylling med Middelhavsdrøm og et nip salt og peber.",
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg kylling i 5-6 min på hver side, eller indtil gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 3,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, hak agurk og løg fint.",
        "Halver cherrytomater.",
        "Hak persille fint.",
        "Skær citrusfrugt i både."
      ]
    },
    {
      "nr": 4,
      "titel": "Lav tabouleh",
      "tekst": [
        "Bland bulgur, cherrytomater, agurk, løg og citrusfrugtsaft i en skål.",
        "Smag til med salt og peber."
      ],
      "tip": "Tilsæt en smule olivenolie."
    },
    {
      "nr": 5,
      "titel": "Lav yoghurtdressing",
      "tekst": [
        "Bland yoghurt, aioli og persille i en lille skål, og krydr med salt og et nip peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret tabouleh og kylling på tallerkener.",
        "Server med yoghurtdressing og resterende citrusfrugtbåde."
      ]
    }
  ],
