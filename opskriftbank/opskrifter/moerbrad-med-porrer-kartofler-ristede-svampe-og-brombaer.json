  "trin": [
    {
      "nr": 1,
      "titel": "Kartofler i ovnen",
      "tekst": [
        "Tænd ovnen på 200°C (almindelig ovn).",
        "Skær kartoflerne i grove stykker, og kom dem i et ovnfast fad.",
        "Vend dem med olivenolie, salt, peber og frisk timian.",
        "Bag kartoflerne i ca. 30 min."
      ]
    },
    {
      "nr": 2,
      "titel": "Brun mørbraden",
      "tekst": [
        "Afpuds mørbraden, og skær sølvsenen af.",
        "Brun den i 25 g smør på en varm pande, til den er gylden hele vejen rundt.",
        "Læg den på et skærebræt, og krydr med salt, peber og friske timiankviste.",
        "Rul skiver af serranoskinke rundt om mørbraden. Brug evt. kødnåle, så skinken bliver siddende."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg mørbrad og porrer",
      "tekst": [
        "Skær porrerne i skrå skiver.",
        "Skru ovnen op på 225°C.",
        "Læg mørbraden i fadet med kartoflerne, og stik porrerne ned mellem kartoflerne.",
        "Steg det hele i 15 min.",
        "Tag mørbraden ud, og hold den varm under et viskestykke. Lad kartoflerne blive lidt længere i ovnen, hvis de ikke er møre endnu."
      ]
    },
    {
      "nr": 4,
      "titel": "Rist svampene",
      "tekst": [
        "Skyl svampene, og riv dem i stykker.",
        "Varm 25 g smør på en pande, til det bruser.",
        "Steg svampene, til de er let gyldne, og krydr dem med salt og peber."
      ]
    },
    {
      "nr": 5,
      "titel": "Anret",
      "tekst": [
        "Skær mørbraden i skiver, og læg dem på et fad med kartofler og porrer.",
        "Pynt med svampe, brombær, ristede valnødder og friske timiankviste."
      ]
    }
  ],
