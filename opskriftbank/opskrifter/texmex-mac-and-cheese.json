  "trin": [
    {
      "nr": 1,
      "titel": "Forbered",
      "tekst": [
        "Tænd ovnen på 190°C (varmluft), og smør et ovnfast fad med smør.",
        "Hak løget fint, og riv hvidløget fint. Skær peberfrugten i små tern, og hak soltørrede tomater og jalapeños fint.",
        "Dræn og skyl bønnerne, riv cheddaren, og knus nachos."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog macaroni i gryden",
      "tekst": [
        "Svits løg og hvidløg i olien i en gryde, til løgene er bløde.",
        "Hæld bouillon og macaroni i, og rør godt rundt. Læg låg på, og lad det simre i 3-4 min."
      ]
    },
    {
      "nr": 3,
      "titel": "Tilsæt grønt og krydderier",
      "tekst": [
        "Kom peberfrugt, majs, soltørrede tomater, jalapeños, spidskommen, koriander, begge slags paprika og sorte bønner i gryden.",
        "Rør godt rundt, og smag til med salt og peber."
      ]
    },
    {
      "nr": 4,
      "titel": "Vend osten i",
      "tekst": [
        "Gem en lille håndfuld cheddar til toppen.",
        "Vend resten af cheddaren og flødeosten i retten, og hæld den i det smurte fad."
      ]
    },
    {
      "nr": 5,
      "titel": "Bag retten",
      "tekst": [
        "Drys knuste nachos og resten af cheddaren over.",
        "Bag i ca. 10-15 min, til osten er gylden."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Server med cremefraiche, et par dryp sriracha og frisk koriander."
      ]
    }
  ],
