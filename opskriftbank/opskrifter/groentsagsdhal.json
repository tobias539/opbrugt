  "trin": [
    {
      "nr": 1,
      "titel": "Forbered grøntsagerne",
      "tekst": [
        "Hak løgene fint, og riv gulerødderne groft.",
        "Riv hvidløg og ingefær fint, og hak blomkålen fint."
      ]
    },
    {
      "nr": 2,
      "titel": "Svits krydderierne",
      "tekst": [
        "Svits løgene i olie i en stor gryde ved middel varme, til de er bløde.",
        "Tilsæt karry, chiliflager, spidskommen og stødt koriander, og rør i ca. 1 min, så krydderierne bliver varmet godt igennem."
      ]
    },
    {
      "nr": 3,
      "titel": "Simr linserne",
      "tekst": [
        "Skyl linserne i en sigte.",
        "Kom linser, gulerødder, squash, hvidløg, ingefær, bouillon, kokosmælk og hakkede tomater i gryden.",
        "Læg låg på, og lad det simre i 20 min. Kog imens risene efter anvisningen på pakken."
      ]
    },
    {
      "nr": 4,
      "titel": "Tilsæt blomkål",
      "tekst": [
        "Rør blomkålen i dhalen, læg låg på, og lad den simre 10-15 min mere.",
        "Kom evt. lidt mere bouillon i, hvis dhalen bliver for tyk."
      ]
    },
    {
      "nr": 5,
      "titel": "Smag til og server",
      "tekst": [
        "Smag til med salt og peber, og rør spinaten i.",
        "Server i dybe skåle med ris, saltede mandler, græsk yoghurt og et drys koriander."
      ]
    }
  ],
  "allergener": {
