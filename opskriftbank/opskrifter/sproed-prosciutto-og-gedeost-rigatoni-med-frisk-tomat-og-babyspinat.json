  "trin": [
    {
      "nr": 1,
      "titel": "Bag prosciutto",
      "tekst": [
        "Forvarm ovnen til 200°C/180°C (varmluft).",
        "Bring en stor gryde med saltet vand i kog.",
        "Fordel prosciutto på en bageplade med bagepapir, og bag i ovnen i 8-10 min, eller indtil gylden og sprød."
      ]
    },
    {
      "nr": 2,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, hak tomat groft.",
        "Skyl spinat."
      ]
    },
    {
      "nr": 3,
      "titel": "Kog pasta",
      "tekst": [
        "Kog pasta i 11-12 min, eller indtil 'al dente'.",
        "Gem en kop pastavand, og hæld resten fra."
      ],
      "tip": "Kogevandet skal være salt som havvand. - 'Al dente' betyder, at pastaen er kogt, men stadig har en smule bid."
    },
    {
      "nr": 4,
      "titel": "Lav sauce",
      "tekst": [
        "Imens, opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg tomat, Hello Sunrise, hakkede tomater, bouillon, creme fraiche, pastavand, salt og sukker, og lad simre i 3-4 min, eller indtil lidt tyknet."
      ],
      "vigtigt": "I denne opskrift bruges halvdelen af mængden af visse ingredienser – dobbelttjek ingredienslisten!"
    },
    {
      "nr": 5,
      "titel": "Tilsæt pasta",
      "tekst": [
        "Imens, hak persille groft.",
        "Riv prosciutto i mindre stykker.",
        "Tilsæt pasta og spinat til stegepanden, og vend sammen.",
        "Krydr med et nip salt og peber."
      ],
      "tip": "Tilsæt et skvæt vand, hvis saucen er for tør."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret pasta i dybe tallerkener.",
        "Top med gedeost, persille og prosciutto."
      ]
    }
