  "trin": [
    {
      "nr": 1,
      "titel": "Forbered råvarer",
      "tekst": [
        "Bring en gryde med saltet vand i kog.",
        "Pres eller hak hvidløg fint.",
        "Skær æble i tynde, halve skiver.",
        "Skær svampe i tynde skiver.",
        "Skær roden af salat, og skil bladene ad. Hak groft."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog pasta",
      "tekst": [
        "Kog pasta i 8-9 min, eller indtil 'al dente'.",
        "Gem en smule pastavand, og hæld resten fra."
      ],
      "tip": "Vandet skal være salt som havvand. - 'Al dente' betyder, at pastaen er kogt, men stadig har en smule bid."
    },
    {
      "nr": 3,
      "titel": "Steg bacon og svampe",
      "tekst": [
        "Imens, opvarm en stegepande på middelhøj varme.",
        "Steg bacon i 4-5 min, eller indtil gylden.",
        "Tilsæt svampe og hvidløg, og steg videre i 5-6 min.",
        "Sænk til middel varme."
      ],
      "tip": "Tilsæt en smule olivenolie, hvis der ikke er nok stegefedt i panden."
    },
    {
      "nr": 4,
      "titel": "Lav æggeblanding",
      "tekst": [
        "Pisk madlavningsfløde, æggeblomme, finrevet ost, bouillon og et nip peber sammen i en skål."
      ],
      "tip": "Æggeblommen gør saucen tyk og cremet."
    },
    {
      "nr": 5,
      "titel": "Tilsæt pasta",
      "tekst": [
        "Tilsæt pasta, et skvæt pastavand og æggeblanding til panden, og lad simre under omrøring i 2 min, eller indtil pasta er dækket af sauce.",
        "Smag til med salt og peber.",
        "Bland æble, salat, olivenolie og et nip salt og peber i en stor skål."
      ],
      "tip": "Tilsæt mere pastavand, hvis saucen er for tyk."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret spaghetti på tallerkener.",
        "Server med salat."
      ]
    }
  ],
