  "trin": [
    {
      "nr": 1,
      "titel": "Bag fritter",
      "tekst": [
        "Forvarm ovnen til 240°C/220°C (varmluft).",
        "Skær kartofler (uskrællet) til fritter.",
        "Fordel på en bageplade med bagepapir. Dryp med en smule olivenolie, krydr med salt og et nip peber, og vend sammen.",
        "Bag i ovnen i 25-35 min, eller indtil møre."
      ],
      "tip": "Benyt flere bageplader, hvis der ikke er plads på en."
    },
    {
      "nr": 2,
      "titel": "Paner kylling",
      "tekst": [
        "Imens, bland panko, salt og et nip peber i en dyb tallerken.",
        "Pisk æg i en anden dyb tallerken.",
        "Skær kylling i 2 cm tykke strimler på et andet skærebræt, og krydr med salt.",
        "Vend kylling i æg og derefter i panko."
      ],
      "tip": "Hvis du ikke har æg, kan det erstattes med 2 spsk mælk."
    },
    {
      "nr": 3,
      "titel": "Steg kylling",
      "tekst": [
        "Hæld olivenolie i en stegepande, så hele bunden er dækket, og varm op på middelhøj varme.",
        "Steg kylling i 3-4 min på hver side, eller indtil gylden og gennemstegt, og overfør til en tallerken med køkkenrulle."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Bland kålsalat",
      "tekst": [
        "Imens, skær æble i tynde, halve skiver.",
        "Bland snittet salat, æble, halvdelen af fraiche, tranebær og et nip salt i en skål. Tilsæt eventuelt en smule olivenolie."
      ]
    },
    {
      "nr": 5,
      "titel": "Lav hvidløgsdressing",
      "tekst": [
        "Bland aioli og resterende fraiche i en lille skål, og krydr med et nip salt og peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret kylling, kålsalat og fritter på tallerkener.",
        "Server med aiolidressing."
      ]
    }
  ],
