  "trin": [
    {
      "nr": 1,
      "titel": "Kog saucen",
      "tekst": [
        "Kom ananasjuice, riseddike, ketchup, brun farin, ingefær, soja og majsstivelse i en gryde.",
        "Bring det i kog under omrøring, og lad saucen simre et par minutter, til den tykner lidt.",
        "Lad den køle lidt af i gryden."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog risene",
      "tekst": [
        "Kog risene som anvist på pakken.",
        "Rist sesamfrøene."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg champignonerne",
      "tekst": [
        "Varm sesamolien i en wok eller sauterpande.",
        "Steg champignonerne ved høj varme, til de har fået en gyldenbrun skorpe."
      ]
    },
    {
      "nr": 4,
      "titel": "Tilsæt grøntsagerne",
      "tekst": [
        "Kom løg, porre, spidskål, peberfrugt og broccoli i.",
        "Steg det hele i 4-5 min under konstant omrøring, til grøntsagerne er gennemvarme."
      ]
    },
    {
      "nr": 5,
      "titel": "Vend saucen i",
      "tekst": [
        "Tilsæt sukkerærter, edamamebønner og sur-sød sauce.",
        "Vend det godt sammen i ca. 1 min."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Server grøntsagerne med ris, og drys med sesamfrø og koriander."
      ]
    }
  ],
