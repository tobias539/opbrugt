  "trin": [
    {
      "nr": 1,
      "titel": "Kog bulgur",
      "tekst": [
        "Bring vand i kog i en mellemstor gryde.",
        "Tilsæt bulgur, halvdelen af bouillon og salt, og kog under låg på middellav varme i 9-10 min, eller indtil bløde."
      ]
    },
    {
      "nr": 2,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, halver cherrytomater.",
        "Halver citrusfrugt.",
        "Skær løg i tynde, halve skiver."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kylling",
      "tekst": [
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg kylling og løg med salt, resterende bouillon og Tex-Mex i 4-5 min, eller indtil gylden og gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Lav dressing",
      "tekst": [
        "Bland mayonnaise, citrusfrugtsaft, vand og et nip salt og peber i en lille skål."
      ]
    },
    {
      "nr": 5,
      "titel": "Forbered avocado",
      "tekst": [
        "Halver avocado, og fjern sten. Grav indmad ud med en ske, og skær i tynde skiver.",
        "Krydr med et nip salt og peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret bulgur i dybe tallerkener.",
        "Top med kylling, tomat og avocado.",
        "Dryp med citrusfrugtdressing.",
        "Server med tortillachips."
      ]
    }
  ],
