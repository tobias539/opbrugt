  "trin": [
    {
      "nr": 1,
      "titel": "Forbered pizzadej",
      "tekst": [
        "Forvarm ovnen til 250°C/240°C (varmluft).",
        "Tag pizzadejen ud af køleskabet og pakken mindst 10 min før tilberedning. Strø bordpladen med hvedemel, og lad pizzadejen hvile på bordpladen. Rul pizzadej ud med hænderne (eller en kagerulle) indtil den er 25 cm i diameter.",
        "Skær løg i tynde, halve skiver.",
        "Pres eller hak hvidløg fint."
      ],
      "tip": "Hvis dejen er svær at rulle ud, så lad den hvile et par minutter og prøv igen."
    },
    {
      "nr": 2,
      "titel": "Steg oksekød",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg hakket oksekød i 3-4 min, eller indtil brunet."
      ]
    },
    {
      "nr": 3,
      "titel": "Tilsæt tomatpuré",
      "tekst": [
        "Tilsæt tomatpuré, hvidløg, vand og Panamad, og steg 1-2 min, eller indtil let tyknet.",
        "Krydr med salt og et nip peber."
      ],
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Bag pizza",
      "tekst": [
        "Fordel kødsauce på pizzadej, og top med løg.",
        "Dryp med BBQ-sauce, og top med gouda.",
        "Bag pizza i ovnen i 12-13 min, eller indtil gylden og gennembagt."
      ]
    },
    {
      "nr": 5,
      "titel": "Lav salsa",
      "tekst": [
        "Imens, hak tomat fint, og overfør til en lille skål.",
        "Halver avocado, og fjern sten. Grav indmad ud med en ske, og skær i 2 cm tern. Overfør til skålen, og vend sammen.",
        "Krydr med et nip salt og peber, og vend eventuelt med en smule olivenolie."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Skær pizza ud i mindre stykker.",
        "Server med salsa."
      ]
    }
  ],
