  "trin": [
    {
      "nr": 1,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Forvarm ovnen til 220°C/200°C varmluft (hvis du ikke har en mikrobølgeovn).",
        "Riv ingefær (uskrællet) og hvidløg fint, og skær citrusfrugt i både.",
        "Flæk chili, fjern kerner, og hak fint.",
        "Riv gulerod (uskrællet) groft.",
        "Rens porre, og skær i tynde, halve skiver."
      ]
    },
    {
      "nr": 2,
      "titel": "Steg kød",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg hakket svine-/kalvekød og porre med salt i 5-6 min, eller indtil brunet.",
        "Imens, bland snittet kålsalat, gulerod, et skvæt citrusfrugtsaft, olivenolie, salt og et nip peber i en skål."
      ],
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 3,
      "titel": "Varm tortillabrød",
      "tekst": [
        "Tilsæt hvidløg og ingefær til stegepanden, og steg videre i 1 min.",
        "Tilsæt asiatisk woksauce, og rør rundt.",
        "Krydr med et stort nip peber.",
        "Varm tortillabrød i 30-60 sek i mikrobølgeovnen, eller pak ind i sølvpapir, og varm i ovnen i 4-5 min."
      ]
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Smør tortillabrød med asiatisk mayonnaise. Fyld med salat, svine-/kalvekød og chili. Server med resterende citrusfrugtbåde."
      ],
      "tip": "Undlad chilien, eller brug mindre, hvis du ikke er til stærk mad."
    }
  ],
