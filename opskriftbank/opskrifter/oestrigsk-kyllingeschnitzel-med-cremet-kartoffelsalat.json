  "trin": [
    {
      "nr": 1,
      "titel": "Kog kartofler",
      "tekst": [
        "Bring en mellemstor gryde med saltet vand i kog.",
        "Skær kartofler (uskrællet) i 2 cm tern.",
        "Kog i 11-13 min, eller indtil de nemt kan deles med en kniv, og hæld vand fra.",
        "Imens, skyl spinat.",
        "Krydr kartofler med et nip salt og peber, tilsæt spinat, og vend indtil den er faldet sammen."
      ]
    },
    {
      "nr": 2,
      "titel": "Forbered kylling",
      "tekst": [
        "Imens, skær skalotteløg i tynde skiver.",
        "Bland skalotteløg og salt i en lille skål, og stil til side.",
        "Læg kylling mellem to stykker bagepapir, bank flade (ca. 2 cm) med en kødhammer eller kagerulle, og krydr med salt."
      ]
    },
    {
      "nr": 3,
      "titel": "Paner kylling",
      "tekst": [
        "Bland hvedemel, salt og et nip peber i en dyb tallerken.",
        "Pisk æg i en anden dyb tallerken.",
        "Kom panko i en tredje dyb tallerken.",
        "Vend kylling i hvedemel, derefter i æg og til sidst i panko, og overfør til en tallerken."
      ],
      "tip": "Hvis du ikke har æg, kan det erstattes med 2 spsk mælk."
    },
    {
      "nr": 4,
      "titel": "Steg kylling",
      "tekst": [
        "Hæld olivenolie i en stegepande, så hele bunden er dækket, og varm op på middelhøj varme.",
        "Steg kylling i 3-4 min på hver side, eller indtil gylden og gennemstegt.",
        "Overfør til en tallerken med køkkenrulle."
      ],
      "tip": "Tilsæt ekstra olivenolie, hvis kyllingen sidder fast i panden. Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Lav kartoffelsalat",
      "tekst": [
        "Hak purløg fint.",
        "Skær citrusfrugt i både.",
        "Vend mayonnaise, crème fraiche, salt, purløg og skalotteløg i gryden med kartofler og spinat."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret kylling og kartoffelsalat på tallerkener.",
        "Server med citrusfrugtbåde."
      ]
    }
  ],
