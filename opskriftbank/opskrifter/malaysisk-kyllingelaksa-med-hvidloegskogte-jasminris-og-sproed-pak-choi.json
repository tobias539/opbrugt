  "trin": [
    {
      "nr": 1,
      "titel": "Kog hvidløgsris",
      "tekst": [
        "Pres eller hak hvidløg fint.",
        "Smelt smør i en gryde på middelhøj varme.",
        "Svits hvidløg i 30 sek, eller indtil velduftende.",
        "Bring vand i kog i en mellemstor gryde. Tilsæt ris og salt, og kog under låg på middellav varme i 12 min. Tag gryden af varmen, og lad hvile under låg i 10 min."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Forbered råvarer",
      "tekst": [
        "Imens, skær peberfrugt i 2 cm tern.",
        "Hak pak choi fint.",
        "Skær citrusfrugt i både."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kylling",
      "tekst": [
        "Opvarm olivenolie i en stegepande på middelhøj varme.",
        "Krydr kylling med salt, og steg i 4-5 min, eller indtil gennemstegt.",
        "Overfør til en tallerken."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Steg peberfrugt",
      "tekst": [
        "Opvarm en smule olivenolie i samme stegepande på middelhøj varme.",
        "Steg peberfrugt med Curry-on og Ga-Laksa i 2-3 min, eller indtil mør."
      ]
    },
    {
      "nr": 5,
      "titel": "Lav laksa",
      "tekst": [
        "Tilsæt kokosmælk, sojasauce, sukker, et skvæt citrusfrugtsaft og kylling, og lad simre i 3-4 min, eller indtil gennemvarmet.",
        "Tilsæt pak choi, når der er 1 min tilbage.",
        "Krydr med salt og et nip peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret ris og laksa i dybe tallerkener.",
        "Server med resterende citrusfrugtbåde."
      ]
    }
  ],
