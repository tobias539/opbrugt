  "trin": [
    {
      "nr": 1,
      "titel": "Forbered råvarer",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Skær portobello i tynde skiver.",
        "Hak løg og hvidløg fint.",
        "Hak basilikum og prosciutto groft.",
        "Skyl spinat.",
        "Skær zucchini i 2 cm tern."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog pasta",
      "tekst": [
        "Tilsæt pasta til gryden med kogende vand, og kog i 11-12 min, eller indtil 'al dente'.",
        "Hæld vand fra, og vend eventuelt pasta med en smule olivenolie i gryden."
      ],
      "tip": "Vandet skal være salt som havvand. - 'Al dente' betyder, at pastaen er kogt, men stadig har en smule bid."
    },
    {
      "nr": 3,
      "titel": "Steg prosciutto",
      "tekst": [
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg prosciutto i 3-4 min, eller indtil sprød, og overfør til en tallerken med køkkenrulle."
      ]
    },
    {
      "nr": 4,
      "titel": "Lav sauce",
      "tekst": [
        "Opvarm samme stegepande (tilsæt en smule olivenolie ved behov) på middelhøj varme.",
        "Steg løg, portobello, zucchini og hvidløg i 4-5 min, eller indtil møre.",
        "Tilsæt bouillon, madlavningsfløde, salt og basilikum, og lad simre i 2-3 min, eller indtil let tyknet."
      ]
    },
    {
      "nr": 5,
      "titel": "Tilsæt pasta",
      "tekst": [
        "Tilsæt pasta, spinat og halvdelen af prosciutto til stegepanden, og rør rundt.",
        "Krydr med et stort nip peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret pasta i dybe tallerkener.",
        "Top med Grana Padano og resterende prosciutto."
      ]
    }
  ],
