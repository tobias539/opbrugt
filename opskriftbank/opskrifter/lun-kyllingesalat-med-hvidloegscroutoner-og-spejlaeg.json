  "trin": [
    {
      "nr": 1,
      "titel": "Forbered råvarer",
      "tekst": [
        "Forvarm ovnen til 220°C/200°C (varmluft).",
        "Pres eller hak hvidløg fint.",
        "Skræl gulerod til lange, tynde bånd, og hak det sidste stykke fint.",
        "Hak tomat groft.",
        "Skyl salat.",
        "Skær brød i små stykker."
      ]
    },
    {
      "nr": 2,
      "titel": "Bag hvidløgscroutoner",
      "tekst": [
        "Fordel brød på en bageplade med bagepapir.",
        "Tilsæt olivenolie, hvidløg og et nip salt og peber, og vend sammen.",
        "Bag i ovnen i 8-10 min, eller indtil gyldne og sprøde."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kylling",
      "tekst": [
        "Imens, opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Skær kylling i mindre stykker (3 pr. person) på et andet skærebræt.",
        "Steg kylling med salt i 3-4 min på hver side, eller indtil brunet og gennemstegt.",
        "Overfør til en tallerken."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Spejl æg",
      "tekst": [
        "Opvarm en smule olivenolie i samme stegepande på middelhøj varme.",
        "Spejl æg i 4-6 min, eller indtil æggehviden er fast og blommen stadig er mest flydende.",
        "Krydr med et nip salt og peber."
      ]
    },
    {
      "nr": 5,
      "titel": "Bland salat",
      "tekst": [
        "Imens, bland sennep, mayonnaise, vand, halvdelen af finrevet ost og salt og et nip peber i en stor skål.",
        "Vend salat, gulerod og tomat i skålen.",
        "Skær kylling i skiver."
      ],
      "tip": "Bland salat lige inden servering."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret salat i dybe tallerkener.",
        "Top med hvidløgscroutoner, kylling og spejlæg.",
        "Drys med resterende finrevet ost."
      ]
    }
  ],
