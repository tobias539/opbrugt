  "trin": [
    {
      "nr": 1,
      "titel": "Kog ris",
      "tekst": [
        "Opvarm olivenolie i en mellemstor gryde på middel varme. Steg ingefærpasta i 1-2 min, eller indtil velduftende. Tilsæt vand, og bring i kog. Tilsæt ris og salt, og kog under låg på middellav varme i 14 min. Tag gryden af varmen, og lad hvile under låg indtil servering.",
        "Imens, pres eller hak hvidløg fint.",
        "Halver porre, rens, og skær i tynde, halve skiver.",
        "Skær radiser i kvarte."
      ],
      "tip": "Fjern ikke låget, mens risen hviler. Rens porre grundigt for jord."
    },
    {
      "nr": 2,
      "titel": "Steg grøntsager",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Tilsæt den hvide del af porre, wokblanding, radiser, hvidløg, sesamfrø, salt og et nip peber, og steg i 3-4 min, eller indtil møre.",
        "Overfør til en tallerken."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg hakket kød",
      "tekst": [
        "Opvarm olivenolie i samme stegepande på middelhøj varme.",
        "Steg hakket svinekød i 3-4 min, eller indtil brunet.",
        "Tilsæt teriyakisauce og vand, og steg videre i 1-2 min, eller indtil gennemvarmet."
      ],
      "tip": "Tilsæt et ekstra skvæt vand, hvis saucen virker tyk.",
      "vigtigt": "Kødet er færdigt, når det er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Anret ris, kød og grøntsager i dybe tallerkener.",
        "Dryp med asiatisk mayonnaise.",
        "Drys med den grønne del af porre."
      ]
    }
  ],
