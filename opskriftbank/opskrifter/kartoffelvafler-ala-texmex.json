  "trin": [
    {
      "nr": 1,
      "titel": "Pres kartoflerne",
      "tekst": [
        "Vend de revne kartofler med lidt salt i en skål.",
        "Lad dem trække væde i 15 min.",
        "Hæld dem i en sigte, og pres så meget væde ud som muligt."
      ]
    },
    {
      "nr": 2,
      "titel": "Bag vaflerne",
      "tekst": [
        "Rør kartoflerne sammen med løg, æg, mel, rasp, cheddar, chiliflager, spidskommen, salt og peber.",
        "Smør vaffeljernet med lidt olie, og bag vaflerne én ad gangen, til de er gyldne og sprøde.",
        "Læg dem på en rist, eller hold dem lune i ovnen, mens du bager resten."
      ]
    },
    {
      "nr": 3,
      "titel": "Lav pico de gallo",
      "tekst": [
        "Kom tomater, rødløg, hvidløg, koriander, limeskal, limesaft og olie i en stor skål.",
        "Tilsæt kun halvdelen af chilien til at begynde med, og vend det hele godt sammen.",
        "Smag til med mere chili, limesaft, limeskal, salt og peber."
      ]
    },
    {
      "nr": 4,
      "titel": "Rør limedressing",
      "tekst": [
        "Rør cremefraiche og mayonnaise sammen.",
        "Smag til med limeskal, lidt limesaft, salt og peber."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
      "tekst": [
        "Server de varme vafler med pico de gallo, avocado og limedressing.",
        "Drys med koriander og chiliflager."
      ]
    }
  ],
