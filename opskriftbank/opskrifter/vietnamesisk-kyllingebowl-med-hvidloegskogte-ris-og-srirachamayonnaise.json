  "trin": [
    {
      "nr": 1,
      "titel": "Kog hvidløgsris",
      "tekst": [
        "Pres eller hak løg fint.",
        "Smelt smør i en mellemstor gryde på middel varme.",
        "Svits løg i 30 sek, eller indtil velduftende.",
        "Tilsæt vand, og bring i kog. Tilsæt ris og salt, og kog under låg på middellav varme i 12 min. Tag gryden af varmen, og lad hvile under låg i 10 min."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Sylt agurk",
      "tekst": [
        "Imens, skær agurk i tynde, halve skiver.",
        "Skær løg i tynde, halve skiver.",
        "Bland hvidvinseddike, sukker, vand og et nip salt i en lille skål.",
        "Vend agurk i skålen, og stil til side.",
        "Hæld væde fra inden servering."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg gulerod og løg",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg gulerod og løg med Ginger-Ninja og et nip salt i 3-4 min, eller indtil bløde.",
        "Overfør til en skål, og dæk til med låg."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg kylling",
      "tekst": [
        "Skær kylling i mindre stykker (3 pr. person) på et andet skærebræt, og krydr med salt.",
        "Opvarm en smule olivenolie samme stegepande på middelhøj varme.",
        "Steg kylling i 3 min på hver side, eller indtil brunet og gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Tilsæt woksauce",
      "tekst": [
        "Tag panden af varmen.",
        "Tilsæt asiatisk woksauce, og vend sammen."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret ris, grøntsager, kylling og agurk i dybe tallerkener.",
        "Top med resterende sauce fra stegepanden.",
        "Drys med mynte og koriander.",
        "Server med srirachamayonnaise."
      ]
    }
  ],
