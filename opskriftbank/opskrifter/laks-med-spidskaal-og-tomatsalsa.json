      ],
      "variabel": "cremet-sauce"
    }
  ],
  "trin": [
    {
      "nr": 1,
      "titel": "Bag laksen",
      "tekst": [
        "Tænd ovnen på 225°C.",
        "Læg laksefileterne på en bageplade med bagepapir, og krydr dem med ½ spsk groft salt og peber.",
        "Bag fisken på den næstøverste rille i 10-15 min."
      ]
    },
    {
      "nr": 2,
      "titel": "Gør kålen sprød",
      "tekst": [
        "Snit spidskålen fint.",
        "Læg den i koldt vand, så den bliver sprød."
      ]
    },
    {
      "nr": 3,
      "titel": "Lav tomatsalsa",
      "tekst": [
        "Skær tomaterne i tern, og snit forårsløgene.",
        "Bland tomat, forårsløg, jalapeño, ½ tsk groft salt, limesaft og olie i en skål."
      ]
    },
    {
      "nr": 4,
      "titel": "Vend kålen i",
      "tekst": [
        "Lad kålen dryppe af, og vend den i salsaen.",
        "Lad gerne grøntsagerne trække i 5-10 min."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
      "tekst": [
        "Server laksen med spidskål i tomatsalsa, fuldkornsboller og friskost."
      ],
      "tip": "Rester af spidskål kan holde 1-2 uger i en plastpose i køleskabets grøntsagsskuffe. Brug dem fx i lynstegte retter."
    }
  ],
  "allergener": {
