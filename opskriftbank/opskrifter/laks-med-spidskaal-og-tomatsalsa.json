    },
    {
      "ingrediens": "foraarsloeg",
      "navn": "Forårsløg",
      "maengde": 4,
      "enhed": "stk",
      "variabel": "loeg"
    },
    {
      "ingrediens": "jalapenos",
      "navn": "Hakket syltet jalapeño",
      "maengde": 5,
      "enhed": "g",
      "note": "1 tsk",
