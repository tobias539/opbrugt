    },
    {
      "ingrediens": "olie",
      "navn": "Olie, fx olivenolie eller koldpresset rapsolie",
      "maengde": 1,
      "enhed": "tsk",
      "basisvare": true
    },
    {
      "ingrediens": "boller",
      "navn": "Fuldkornsboller",
      "maengde": 4,
      "enhed": "stk",
      "note": "svarende til 500 g",
      "allergener": [
        "gluten",
        "hvede"
      ]
    },
    {
      "ingrediens": "flodeost",
      "navn": "Friskost",
      "maengde": 30,
      "enhed": "g",
