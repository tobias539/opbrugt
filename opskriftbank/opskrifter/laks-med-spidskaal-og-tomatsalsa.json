    },
    {
      "ingrediens": "salt",
      "navn": "Groft salt",
      "maengde": 0.5,
      "enhed": "tsk",
      "basisvare": true,
      "note": "Til salsaen. Kilden skriver ½ tsk i ingredienslisten, men ¼ tsk i fremgangsmåden."
    },
