  "trin": [
    {
      "nr": 1,
      "titel": "Steg bacon",
      "tekst": [
        "Forvarm ovnen til 200°C/180°C (varmluft).",
        "Opvarm en stor stegepande på middelhøj varme.",
        "Steg bacon i 4-5 min, eller indtil gylden, og overfør til en tallerken med køkkenrulle.",
        "Imens, skær svampe i tynde skiver."
      ]
    },
    {
      "nr": 2,
      "titel": "Steg grøntsager",
      "tekst": [
        "Smelt smør i samme stegepande på middelhøj varme.",
        "Steg svampe i 4-5 min, eller indtil bløde.",
        "Imens, hak løg og hvidløg fint.",
        "Tilsæt løg, hvidløg og risottoris, og steg videre i 1-2 min, eller indtil gennemsigtige."
      ]
    },
    {
      "nr": 3,
      "titel": "Forbered risotto",
      "tekst": [
        "Tilsæt vand, Hvide Løjer & Urter, bouillon og salt, og bring i kog.",
        "Sænk til middel varme, og lad simre i 18-22 min, eller indtil bouillonen er absorberet og risen er 'al dente'."
      ]
    },
    {
      "nr": 4,
      "titel": "Bag kylling",
      "tekst": [
        "Imens, krydr kylling med salt.",
        "Opvarm en smule olivenolie i en anden stor stegepande på middelhøj varme.",
        "Steg kylling i 2 min på hver side, eller indtil brunet.",
        "Overfør til en bageplade med bagepapir, og bag i ovnen i 11-12 min, eller indtil gennemtilberedt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Lav risotto",
      "tekst": [
        "Imens, skyl spinat.",
        "Halver citrusfrugt.",
        "Tag panden af varmen, når risen er færdigkogt. Rør bacon, spinat, citrusfrugtsaft, smør og halvdelen af finrevet ost i, og smag til med et nip salt og peber.",
        "Skær kylling i skiver.",
        "Hak persille fint."
      ],
      "tip": "Tilsæt et skvæt vand, hvis risottoen ser tør ud."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret risotto i dybe tallerkener.",
        "Top med kylling.",
        "Drys med persille og resterende finrevet ost."
      ]
    }
  ],
