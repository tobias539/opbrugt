  "trin": [
    {
      "nr": 1,
      "titel": "Bag rodfrugter",
      "tekst": [
        "Forvarm ovnen til 240°C/220°C (varmluft).",
        "Skær kartofler (uskrællet), rødbede (uskrællet), pastinak (uskrællet) og gulerod (uskrællet) i 2 cm tern.",
        "Fordel på en bageplade med bagepapir. Dryp med en smule olivenolie, krydr med salt og et nip peber, og vend sammen.",
        "Bag i ovnen i 25-35 min, eller indtil møre."
      ],
      "tip": "Benyt flere bageplader, hvis der ikke er plads på en."
    },
    {
      "nr": 2,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Skær rødløg i 2 cm både.",
        "Skær peberfrugt i 1 cm strimler.",
        "Hak persille groft."
      ]
    },
    {
      "nr": 3,
      "titel": "Brun kylling",
      "tekst": [
        "Krydr kylling med salt.",
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Brun kylling i 2 min på hver side."
      ]
    },
    {
      "nr": 4,
      "titel": "Bag kylling og grøntsager",
      "tekst": [
        "Overfør kylling til en bageplade med bagepapir.",
        "Fordel rødløg og peberfrugt på samme bageplade, og bag i ovnen i 11-12 min, eller indtil kyllingen er gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Opvarm BBQ-sauce",
      "tekst": [
        "Opvarm samme stegepande på middel varme, når kyllingen og grøntsagerne har 5 min tilbage.",
        "Tilsæt bouillon, BBQ-sauce og vand, og lad simre i 2-3 min, eller indtil tyknet.",
        "Krydr med salt og et nip peber.",
        "Bland grøntsager med rodfrugter og persille på bagepladen.",
        "Skær kylling i skiver."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret grøntsager, rodfrugter og kylling på tallerkener.",
        "Top kylling med BBQ-sauce."
      ]
    }
  ],
