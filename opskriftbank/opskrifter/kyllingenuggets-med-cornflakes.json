  "trin": [
    {
      "nr": 1,
      "titel": "Forbered kyllingen",
      "tekst": [
        "Tænd ovnen på 200°C.",
        "Skær eventuelle hinder og sener af inderfileterne."
      ]
    },
    {
      "nr": 2,
      "titel": "Gør paneringen klar",
      "tekst": [
        "Bland mel, paprika, salt og peber i en skål.",
        "Pisk æggene let sammen med en gaffel i en anden skål.",
        "Kom cornflakes i en frostpose, knus dem let med hånden, og hæld dem ud på en tallerken."
      ]
    },
    {
      "nr": 3,
      "titel": "Paner kyllingen",
      "tekst": [
        "Vend hver inderfilet først i melblandingen, så i æggene og til sidst i cornflakes.",
        "Læg stykkerne på en bageplade med bagepapir."
      ]
    },
    {
      "nr": 4,
      "titel": "Bag nuggets",
      "tekst": [
        "Bag dem i ovnen ved 200°C i ca. 22 min, til de er sprøde og gyldne, og kyllingen er gennemstegt."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
