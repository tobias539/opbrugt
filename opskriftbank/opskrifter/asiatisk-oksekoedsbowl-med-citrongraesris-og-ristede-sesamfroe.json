  "trin": [
    {
      "nr": 1,
      "titel": "Forbered citrongræs",
      "tekst": [
        "Bank citrongræs med en kagerulle."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog citrongræsris",
      "tekst": [
        "Opvarm olivenolie i en mellemstor gryde på middel varme.",
        "Svits citrongræs i 1-2 min, eller indtil velduftende.",
        "Tilsæt vand, og bring i kog. Tilsæt ris og salt, og kog under låg på middellav varme i 14 min. Tag gryden af varmen, og lad hvile under låg i 10 min.",
        "Fjern citrongræs."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 3,
      "titel": "Forbered grøntsager",
      "tekst": [
        "Imens, hak thaibasilikum fint.",
        "Riv gulerod (uskrællet) groft.",
        "Skær citrusfrugt i både.",
        "Hak pak choi groft."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg hakket oksekød",
      "tekst": [
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg hakket oksekød i 4-5 min, eller indtil brunet."
      ],
      "vigtigt": "Kødet er færdigt, når det er uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Tilsæt pak choi",
      "tekst": [
        "Tilsæt pak choi, sojasauce, asiatisk woksauce, salt, et nip peber og et stort skvæt citrusfrugtsaft.",
        "Lad simre i 1-2 min, eller indtil saucen er tyknet og pak choien er mør."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret ris, gulerod og oksekød i dybe tallerkener.",
        "Top med sesamfrø, thaibasilikum og srirachamayonnaise.",
        "Server med resterende citrusfrugtbåde."
      ]
    }
