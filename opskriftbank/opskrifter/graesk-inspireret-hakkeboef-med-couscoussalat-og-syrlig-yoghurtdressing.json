  "trin": [
    {
      "nr": 1,
      "titel": "Bag grøntsager",
      "tekst": [
        "Forvarm ovnen til 220°C/200°C (varmluft).",
        "Skær zucchini i 1 cm tynde, halve skiver.",
        "Skær løg i 2 cm både.",
        "Fordel på en bageplade med bagepapir. Dryp med en smule olivenolie, krydr med salt og et nip peber, og vend sammen.",
        "Bag i ovnen i 15 min."
      ]
    },
    {
      "nr": 2,
      "titel": "Bland fars",
      "tekst": [
        "Bland hakket svine-/kalvekød, Middelhavsdrøm, rasp, æg og salt i en skål.",
        "Form fars til hakkebøffer (2 pr. person)."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg hakkebøffer",
      "tekst": [
        "Opvarm en smule olivenolie i en stor stegepande på middelhøj varme.",
        "Steg hakkebøffer i 5-6 min på hver side, eller indtil gennemstegte."
      ],
      "vigtigt": "Hakkebøfferne er færdige, når kødet er gennemstegt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Kog couscous",
      "tekst": [
        "Imens, bring en gryde med vand og bouillon i kog.",
        "Tilsæt couscous, salt og olivenolie, og rør rundt.",
        "Tag gryden af varmen, og lad hvile under låg i 5 min, eller indtil vandet er absorberet."
      ]
    },
    {
      "nr": 5,
      "titel": "Bland dressing",
      "tekst": [
        "Skær citron i både.",
        "Hak persille groft, og skær tomat i 2 cm tern.",
        "Vend bagte grøntsager i gryden med couscous.",
        "Tilsæt smuldret græsk ost, et skvæt citronsaft, tomat, olivenolie, halvdelen af persille og et nip salt og peber, og rør rundt.",
        "Bland yoghurt, et skvæt citronsaft og et nip salt og peber i en lille skål."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret hakkebøffer, couscoussalat og dressing på tallerkener.",
        "Drys med resterende persille.",
        "Server med resterende citronbåde."
      ]
    }
