  "trin": [
    {
      "nr": 1,
      "titel": "Lav dressingen",
      "tekst": [
        "Rør cremefraiche med purløg, sukker, sennep, salt og peber.",
        "Smag godt til, og lad dressingen trække, mens du laver resten."
      ]
    },
    {
      "nr": 2,
      "titel": "Rør farsen",
      "tekst": [
        "Rør svinekød, mel, havregryn, mælk, æg, løg, hvidløg, timian, salt og peber sammen til en fars.",
        "Lad farsen trække i mindst 15 min, gerne længere."
      ]
    },
    {
      "nr": 3,
      "titel": "Fyld pitabrødene",
      "tekst": [
        "Tænd ovnen på 200°C varmluft.",
        "Fordel farsen i de halve pitabrød.",
        "Tryk dem flade, så farsen ligger i et tyndt og jævnt lag."
      ]
    },
    {
      "nr": 4,
      "titel": "Bag pitabrødene",
      "tekst": [
        "Pensl brødene med olie.",
        "Bag dem i ca. 12-15 min, til de er sprøde, og farsen er gennemstegt."
      ]
    },
    {
      "nr": 5,
      "titel": "Server",
      "tekst": [
        "Server de lune pitabrød med cremefraichedressingen og andet tilbehør efter smag."
      ]
    }
  ],
