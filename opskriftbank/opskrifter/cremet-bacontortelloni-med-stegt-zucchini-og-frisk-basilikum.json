  "trin": [
    {
      "nr": 1,
      "titel": "Steg bacon og grøntsager",
      "tekst": [
        "Skær tomat og zucchini i 2 cm tern.",
        "Opvarm en mellemstor stegepande på middelhøj varme.",
        "Steg bacon, tomat og zucchini i 4-5 min, eller indtil baconen er gennemstegt og zucchinien er mør."
      ]
    },
    {
      "nr": 2,
      "titel": "Tilsæt pasta",
      "tekst": [
        "Sænk til middel varme.",
        "Tilsæt tortelloni, og steg videre i 1 min."
      ]
    },
    {
      "nr": 3,
      "titel": "Lav sauce",
      "tekst": [
        "Tilsæt madlavningsfløde, vand, bouillon, Mamas Favorit og salt, og lad simre i 3-4 min, eller indtil pastaen er 'al dente' og saucen er let tyknet."
      ],
      "tip": "'Al dente' betyder, at pastaen er kogt, men stadig har en smule bid."
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Anret tortelloni i dybe tallerkener.",
        "Top med finrevet ost, chiliflager og basilikum."
      ],
      "tip": "Spring chiliflagerne over, eller brug mindre, hvis du ikke er til stærk mad."
    }
  ],
