  "trin": [
    {
      "nr": 1,
      "titel": "Læg ærterne i blød",
      "tekst": [
        "Kom gråærterne i en skål med koldt vand.",
        "Stil dem i køleskabet natten over, dog mindst 12 timer."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog ærterne",
      "tekst": [
        "Hæld udblødningsvandet fra.",
        "Kog ærterne i 20 min i nyt vand med lidt salt.",
        "Lad dem trække i vandet i 10 min.",
        "Hæld vandet fra gennem en si, men gem kogevandet."
      ]
    },
    {
      "nr": 3,
      "titel": "Forbered grøntsagerne",
      "tekst": [
        "Skær skalotteløg og soltørrede tomater i strimler.",
        "Hak hvidløg og persille fint."
      ]
    },
    {
      "nr": 4,
      "titel": "Svits og simr",
      "tekst": [
        "Varm olien i en pande eller gryde, og svits skalotteløg og soltørrede tomater i et par minutter.",
        "Kom hvidløg i, og steg 1 min mere.",
        "Tilsæt de kogte ærter, oregano, chiliflager, tomatpuré og 3 dl af kogevandet.",
        "Lad retten simre i 10 min."
      ]
    },
    {
      "nr": 5,
      "titel": "Tilsæt fløde og spinat",
      "tekst": [
        "Rør fløde og spinat i, og lad retten koge færdig i 10 min.",
        "Smag til med salt."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Drys retten med parmesan, den hakkede persille og lidt frisk basilikum."
      ]
    }
  ],
  "allergener": {
