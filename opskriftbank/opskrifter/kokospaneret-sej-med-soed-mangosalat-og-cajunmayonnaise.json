  "trin": [
    {
      "nr": 1,
      "titel": "Kog ingefærris",
      "tekst": [
        "Riv ingefær (uskrællet) fint.",
        "Opvarm olivenolie i en mellemstor gryde på middel varme.",
        "Svits ingefær i 30 sek, eller indtil velduftende.",
        "Tilsæt vand, og bring i kog.",
        "Tilsæt ris og salt, og kog under låg på middellav varme i 14 min. Tag gryden af varmen, og lad hvile under låg i 10 min."
      ],
      "tip": "Fjern ikke låget, mens risen hviler."
    },
    {
      "nr": 2,
      "titel": "Lav mangosalsa",
      "tekst": [
        "Imens, skræl mango, skær over på langs ca. 1 cm fra midten uden om stenen, og skær i 2 cm tern.",
        "Hak tomat groft.",
        "Bland mango, tomat, olivenolie, salt og et nip peber i en mellemstor skål."
      ]
    },
    {
      "nr": 3,
      "titel": "Paner fisk",
      "tekst": [
        "Bland hvedemel, salt og et nip peber i en dyb tallerken.",
        "Pisk æg i en anden dyb tallerken.",
        "Bland panko, kokosmel og halvdelen af Ay Cajun-ba i en tredje dyb tallerken.",
        "Dup fisk tør med køkkenrulle, og krydr med salt.",
        "Vend fisk i hvedemel, derefter i æg og til sidst i panering."
      ],
      "tip": "Hvis du ikke har æg, kan det erstattes med 2 spsk mælk."
    },
    {
      "nr": 4,
      "titel": "Steg fisk",
      "tekst": [
        "Hæld olivenolie i en stegepande, så hele bunden er dækket, og varm op på middelhøj varme.",
        "Steg fisk i 2-3 min på hver side, eller indtil gylden og gennemstegt, og overfør til en tallerken med køkkenrulle."
      ],
      "tip": "Fisken er færdig, når kødet er mælkehvidt og mat."
    },
    {
      "nr": 5,
      "titel": "Lav cajunmayonnaise",
      "tekst": [
        "Imens, bland mayonnaise, resterende Ay Cajun-ba, et skvæt vand, salt og et nip peber i en lille skål."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Kom hver portion ris i en lille skål, og pres let sammen. Placer en tallerken ovenpå, og vend på hovedet, så risen får form som en kuppel. Fortsæt med risen til resten af portionerne.",
        "Anret fisk og mangosalsa ved siden af.",
        "Server med cajunmayonnaise."
      ]
    }
  ],
