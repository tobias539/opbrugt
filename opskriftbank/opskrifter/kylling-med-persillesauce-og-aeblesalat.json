  "trin": [
    {
      "nr": 1,
      "titel": "Forbered råvarer",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Halver kartofler (uskrællet).",
        "Hak persille groft."
      ]
    },
    {
      "nr": 2,
      "titel": "Kog kartofler",
      "tekst": [
        "Kog kartofler i 12-15 min, eller indtil møre, og hæld vand fra.",
        "Krydr med et nip salt og peber, stil til side, og dæk til med låg."
      ]
    },
    {
      "nr": 3,
      "titel": "Steg kylling",
      "tekst": [
        "Imens, skær kylling i 3 cm tykke strimler på et andet skærebræt.",
        "Opvarm en smule olivenolie i en stegepande på middelhøj varme.",
        "Vend kylling med olivenolie, salt og Hvide Løjer & Urter i en skål.",
        "Steg kylling i 3 min på hver side, eller indtil gennemstegt, og overfør til en tallerken."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 4,
      "titel": "Lav æblesalat",
      "tekst": [
        "Imens, skær æble i tynde, halve skiver.",
        "Skær agurk i halve skiver.",
        "Kom spidskål i en stor skål, og masser med en smule olivenolie i 30 sek.",
        "Tilsæt æble, agurk, tranebær, salt og et nip peber, og vend sammen."
      ]
    },
    {
      "nr": 5,
      "titel": "Lav persillesauce",
      "tekst": [
        "Pres eller hak hvidløg fint.",
        "Smelt smør i samme stegepande på middelhøj varme.",
        "Svits hvidløg i 1 min, eller indtil velduftende.",
        "Tilsæt madlavningsfløde, bouillon og persille, og lad simre i 1-2 min, eller indtil gennemvarmet.",
        "Krydr med salt og et stort nip peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret kartofler, kylling og æblesalat på tallerkener.",
        "Top kylling med persillesauce."
      ]
    }
  ],
