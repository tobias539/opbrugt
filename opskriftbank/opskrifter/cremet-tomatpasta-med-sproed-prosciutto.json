  "trin": [
    {
      "nr": 1,
      "titel": "Kog pasta",
      "tekst": [
        "Bring en stor gryde med saltet vand i kog.",
        "Kog pasta i 11-12 min, eller indtil 'al dente'.",
        "Gem en kop pastavand, og hæld resten fra.",
        "Opvarm olivenolie i en stor stegepande på middelhøj varme.",
        "Steg prosciutto i 3-4 min, eller indtil sprød.",
        "Overfør til en tallerken med køkkenrulle."
      ],
      "tip": "Vandet skal være salt som havvand. - 'Al dente' betyder, at pastaen er kogt, men stadig har en smule bid."
    },
    {
      "nr": 2,
      "titel": "Steg grøntsager",
      "tekst": [
        "Imens, skær løg i tynde, halve skiver.",
        "Skyl spinat.",
        "Pluk basilikum.",
        "Pres eller hak hvidløg fint.",
        "Skær tomat i 2 cm tern.",
        "Opvarm samme stegepande (tilsæt en smule olivenolie ved behov) på middel varme.",
        "Steg tomat, løg, balsamico, sukker, salt og et nip peber i 3-4 min, eller indtil bløde og karamelliseret."
      ]
    },
    {
      "nr": 3,
      "titel": "Lav sauce",
      "tekst": [
        "Tilsæt tomatpuré, hvidløg og Mamas Favorit, og steg videre i 1 min, eller indtil velduftende.",
        "Tilsæt pasta, pastavand, madlavningsfløde, bouillon, spinat og basilikum, og sænk til middel varme.",
        "Lad simre 1-2 min, eller indtil saucen er tyknet og spinaten faldet sammen.",
        "Krydr med salt og et nip peber."
      ]
    },
    {
      "nr": 4,
      "titel": "Server",
      "tekst": [
        "Anret pasta i dybe tallerkener.",
        "Top med prosciutto."
      ]
    }
  ],
