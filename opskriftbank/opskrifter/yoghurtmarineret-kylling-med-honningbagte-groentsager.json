  "trin": [
    {
      "nr": 1,
      "titel": "Bag grøntsager",
      "tekst": [
        "Forvarm ovnen til 240°C/220°C (varmluft).",
        "Skær gulerod (uskrællet) i 2 cm tern.",
        "Halver cherrytomater.",
        "Skær løg i 2 cm både.",
        "Fordel grøntsager på en bageplade med bagepapir. Dryp med honning og en smule olivenolie, krydr med salt og et nip peber, og vend sammen.",
        "Bag i ovnen i 20-30 min, eller indtil møre."
      ]
    },
    {
      "nr": 2,
      "titel": "Mariner kylling",
      "tekst": [
        "Imens, pres eller hak hvidløg fint.",
        "Skær citrusfrugt i både.",
        "Bland kylling, Mamas Favorit, hvidløg, olivenolie, halvdelen af yoghurt, salt og et nip peber i en mellemstor skål."
      ]
    },
    {
      "nr": 3,
      "titel": "Kog perlecouscous",
      "tekst": [
        "Bring vand, bouillon og salt i kog i en mellemstor gryde.",
        "Tilsæt perlecouscous, og kog under låg på middellav varme i 12-15 min, eller indtil bløde.",
        "Hæld overskydende vand fra."
      ]
    },
    {
      "nr": 4,
      "titel": "Steg kylling",
      "tekst": [
        "Smelt smør i en stor stegepande på middel varme, når perlecouscousen har 10 min tilbage.",
        "Steg kylling og marinade i 4-5 min, eller indtil brunet og gennemstegt."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 5,
      "titel": "Tilsæt persilleyoghurt",
      "tekst": [
        "Imens, hak persille fint.",
        "Bland persille og resterende yoghurt i en lille skål.",
        "Vend persilleyoghurt i gryden med færdigkogt perlecouscous.",
        "Krydr med et nip salt og peber."
      ]
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret perlecouscous, grøntsager og kylling i dybe tallerkener.",
        "Server med citrusfrugtbåde."
      ]
    }
  ],
