  "trin": [
    {
      "nr": 1,
      "titel": "Skær kartofler",
      "tekst": [
        "Forvarm ovnen til 240°C/220°C (varmluft).",
        "Skær kartofler (uskrællet) i 2 cm tern."
      ]
    },
    {
      "nr": 2,
      "titel": "Bag kartofler",
      "tekst": [
        "Fordel kartofler på en bageplade med bagepapir. Dryp med en smule olivenolie, krydr med salt og et nip peber, og vend sammen.",
        "Bag i ovnen i 25-35 min, eller indtil møre."
      ]
    },
    {
      "nr": 3,
      "titel": "Forbered råvarer",
      "tekst": [
        "Imens, skær broccoli i buketter (inklusive stokken) i 1 cm tern.",
        "Skyl rucola.",
        "Hak peberfrugt groft.",
        "Halver cherrytomater.",
        "Vend kylling med en smule olivenolie, Jorden Rundt og salt i en mellemstor skål."
      ]
    },
    {
      "nr": 4,
      "titel": "Bag kylling og broccoli",
      "tekst": [
        "Tag bagepladen ud af ovnen, når kartoflerne har 20 min tilbage.",
        "Placer kylling og broccoli på samme bageplade. Dryp broccoli med en smule olivenolie, og krydr med et nip salt og peber.",
        "Bag i ovnen i 17-19 min."
      ],
      "tip": "Benyt flere bageplader, hvis der ikke er plads på en."
    },
    {
      "nr": 5,
      "titel": "Lav rucolasalat",
      "tekst": [
        "Top kylling med gouda, når der er 5 min tilbage.",
        "Bag i resterende tid, eller indtil osten er smeltet og kyllingen er gennemtilberedt.",
        "Bland rucola, peberfrugt, cherrytomater, balsamico, olivenolie og et nip salt og peber i en mellemstor skål."
      ],
      "tip": "Kyllingen er færdig, når kødet er hvidt og uden antydning af rødt."
    },
    {
      "nr": 6,
      "titel": "Server",
      "tekst": [
        "Anret broccoli, kartofler, kylling og rucolasalat på tallerkener.",
        "Top kartofler med sesamfrø.",
        "Server med aioli."
      ]
    }
  ],
